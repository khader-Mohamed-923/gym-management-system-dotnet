@{
    ViewData["Title"] = "Delete Trainer";
}

<div class="container py-5">
    
    <div class="ke-header-content mb-5">
        <div class="ke-header-text">
            <h1 class="ke-title text-error">DELETE TRAINER</h1>
            <p class="ke-subtitle">Confirm trainer removal</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card card-elevated text-center p-4 p-md-5" style="border-top: 4px solid var(--error);">
                
                <div class="display-lg mb-4 text-error">⚠️</div>
                
                <h2 class="display-md mb-4 text-error">
                    Are you sure you want to remove this trainer?
                </h2>

                <div class="text-start mb-5 p-4 border-structural bg-surface">
                    <div class="ke-detail-block mb-3">
                        <div class="ke-detail-label mb-1">Name</div>
                        <div class="ke-detail-value text-on-surface fw-bold">@Model.Name</div>
                    </div>
                    <div class="ke-detail-block mb-3">
                        <div class="ke-detail-label mb-1">Email</div>
                        <div class="ke-detail-value data-mono">@Model.Email</div>
                    </div>
                    <div class="ke-detail-block mb-3">
                        <div class="ke-detail-label mb-1">Phone</div>
                        <div class="ke-detail-value data-mono">@Model.Phone</div>
                    </div>
                    <div class="ke-detail-block">
                        <div class="ke-detail-label mb-1">Specialty</div>
                        <div class="ke-detail-value data-mono">@Model.Specialty Trainer</div>
                    </div>
                </div>

                <div class="mb-4 p-3 border-structural bg-surface text-start d-flex gap-3" style="border-left-color: var(--error);">
                    <i class="bi bi-exclamation-triangle-fill text-error fs-4 mt-1"></i>
                    <div>
                        <strong class="d-block mb-1 text-error">Please confirm</strong>
                        <span class="body-sm text-muted">This trainer will be removed from the system and will no longer appear in active lists.</span>
                    </div>
                </div>

                <form asp-action="Delete" method="post" asp-route-id="@Model.Id">
                    @Html.AntiForgeryToken()
                    <div class="d-flex justify-content-center gap-3">
                        <a asp-controller="Trainers" asp-action="Index" class="btn-secondary px-4 py-2">
                            No, Cancel
                        </a>
                        <button type="submit" class="ke-btn px-4 py-2" style="background: var(--error); border-color: var(--error);">
                            Yes, Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
