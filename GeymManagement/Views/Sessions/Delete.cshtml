@model SessionEditViewModel

@{
    ViewData["Title"] = "Delete Session";
}

<div class="container py-5">
    <div class="ke-header-content mb-5">
        <div class="ke-header-text">
            <h1 class="ke-title text-error">DELETE SESSION</h1>
            <p class="ke-subtitle">Confirm session deletion</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card card-elevated text-center p-4 p-md-5" style="border-top: 4px solid var(--error);">
                <div class="display-lg mb-4 text-error">⚠️</div>
                <h2 class="display-md mb-3 text-error">
                    ARE YOU SURE YOU WANT TO DELETE THIS SESSION?
                </h2>
                <p class="body-md text-muted mb-5">
                    This action cannot be undone. The session will be permanently removed.
                </p>

                <div class="text-start mb-5 p-4 border-structural bg-surface">
                    <div class="ke-detail-block mb-3">
                        <div class="ke-detail-label mb-1">Description</div>
                        <div class="ke-detail-value text-on-surface fw-bold">@Model.Description</div>
                    </div>
                    <div class="ke-detail-block mb-3">
                        <div class="ke-detail-label mb-1">Capacity</div>
                        <div class="ke-detail-value data-mono">@Model.Capacity slots</div>
                    </div>
                    <div class="ke-detail-block mb-3">
                        <div class="ke-detail-label mb-1">Start Date</div>
                        <div class="ke-detail-value data-mono">@Model.StartDate?.ToString("MMM dd, yyyy HH:mm")</div>
                    </div>
                    <div class="ke-detail-block">
                        <div class="ke-detail-label mb-1">End Date</div>
                        <div class="ke-detail-value data-mono">@Model.EndDate?.ToString("MMM dd, yyyy HH:mm")</div>
                    </div>
                </div>

                <form method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="d-flex justify-content-center gap-3">
                        <a asp-controller="Sessions" asp-action="Index" class="btn-secondary px-4 py-2 text-decoration-none">
                            Cancel
                        </a>
                        <button type="submit" class="ke-btn px-4 py-2" style="background: var(--error); border-color: var(--error);">
                            Delete Session
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
