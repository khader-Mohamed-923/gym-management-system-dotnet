@model RegisterRequest

@{
    ViewData["Title"] = "Register";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card card-elevated">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-person-plus fs-1 text-primary"></i>
                        <h2 class="display-md mt-2">Create Account</h2>
                        <p class="body-md text-muted">Join IronCore Gym today</p>
                    </div>

                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                    {
                        <div class="mb-4 p-3" style="border: 2px solid var(--error); background: var(--surface-container-low);">
                            <div class="d-flex align-items-start">
                                <i class="bi bi-shield-exclamation me-2 mt-1 text-primary"></i>
                                <div>
                                    <strong class="text-primary data-mono">Security Notice</strong><br>
                                    <span class="label-sm text-muted">For your protection, please re-enter your password and re-select your profile photo.</span>
                                </div>
                            </div>
                        </div>
                    }

                    <form asp-action="Register" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-error mb-3 small"></div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="FirstName" class="label-sm mb-1">First Name</label>
                                    <input asp-for="FirstName" class="input-field" placeholder="First Name" />
                                    <span asp-validation-for="FirstName" class="text-error small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="LastName" class="label-sm mb-1">Last Name</label>
                                    <input asp-for="LastName" class="input-field" placeholder="Last Name" />
                                    <span asp-validation-for="LastName" class="text-error small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="UserName" class="label-sm mb-1">Username</label>
                            <input asp-for="UserName" class="input-field" placeholder="Username" />
                            <span asp-validation-for="UserName" class="text-error small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="label-sm mb-1">Email Address</label>
                            <input asp-for="Email" type="email" class="input-field" placeholder="Email" />
                            <span asp-validation-for="Email" class="text-error small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="label-sm mb-1">Password</label>
                            <input asp-for="Password" type="password" class="input-field" placeholder="Password" />
                            <span asp-validation-for="Password" class="text-error small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Phone" class="label-sm mb-1">Phone Number</label>
                                    <input asp-for="Phone" class="input-field" placeholder="Phone" />
                                    <span asp-validation-for="Phone" class="text-error small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="DateOfBirth" class="label-sm mb-1">Date of Birth (Optional)</label>
                                    <input asp-for="DateOfBirth" type="date" class="input-field" placeholder="Date of Birth" style="color-scheme: dark;" />
                                    <span asp-validation-for="DateOfBirth" class="text-error small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Gender" class="label-sm mb-1">Gender</label>
                            <select asp-for="Gender" asp-items="Html.GetEnumSelectList<GymManagement.Domain.Enums.Gender>()" class="input-field">
                                <option value="" style="background-color: var(--surface); color: var(--on-surface);">Select Gender (Optional)</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-error small"></span>
                        </div>

                        <div class="mb-4">
                            <h6 class="ke-section-header">PROFILE PHOTO</h6>
                            <label asp-for="ProfilePhotoFile" class="label-sm mb-1">PHOTO</label>
                            <input asp-for="ProfilePhotoFile" type="file" class="input-field" accept=".jpg,.jpeg,.png,.webp" />
                            <div class="body-sm text-muted mt-2">Accepted formats: JPG, JPEG, PNG, WEBP. Max size: 5 MB.</div>
                            <span asp-validation-for="ProfilePhotoFile" class="text-error small"></span>
                        </div>

                        <button type="submit" class="ke-btn ke-btn-primary w-100 mb-3">
                            CREATE ACCOUNT
                        </button>

                        <div class="text-center">
                            <p class="body-md text-muted mb-0">Already have an account? <a asp-controller="Auth" asp-action="Login" class="text-decoration-none text-primary">Sign in</a></p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

            @section Scripts {
                <partial name="_ValidationScriptsPartial" />
            }