@model UpdateMemberProfileRequest
@{
    ViewData["Title"] = "Complete Profile";
    Layout = "~/Views/Shared/_MemberLayout.cshtml";
}

<div class="container py-5">
    <div class="ke-header-content mb-5">
        <div class="ke-header-text">
            <h1 class="ke-title">COMPLETE PROFILE</h1>
            <p class="ke-subtitle">Update your address and health information.</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card card-elevated">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="CompleteProfile" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-error mb-4 small"></div>

                        <h5 class="ke-section-header mb-4 text-primary pb-2 border-bottom border-structural">ADDRESS</h5>
                        
                        <div class="row g-4 mb-5">
                            <div class="col-md-4">
                                <label asp-for="BuildingNumber" class="label-sm mb-1">Building No.</label>
                                <input asp-for="BuildingNumber" type="number" class="input-field" />
                                <span asp-validation-for="BuildingNumber" class="text-error small"></span>
                            </div>
                            <div class="col-md-8">
                                <label asp-for="Street" class="label-sm mb-1">Street</label>
                                <input asp-for="Street" class="input-field" />
                                <span asp-validation-for="Street" class="text-error small"></span>
                            </div>
                            <div class="col-md-12">
                                <label asp-for="City" class="label-sm mb-1">City</label>
                                <input asp-for="City" class="input-field" />
                                <span asp-validation-for="City" class="text-error small"></span>
                            </div>
                        </div>

                        <h5 class="ke-section-header mb-4 text-primary pb-2 border-bottom border-structural">HEALTH RECORD</h5>

                        <div class="row g-4 mb-5">
                            <div class="col-md-4">
                                <label asp-for="Height" class="label-sm mb-1">Height (cm)</label>
                                <input asp-for="Height" type="number" step="0.1" class="input-field" />
                                <span asp-validation-for="Height" class="text-error small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Weight" class="label-sm mb-1">Weight (kg)</label>
                                <input asp-for="Weight" type="number" step="0.1" class="input-field" />
                                <span asp-validation-for="Weight" class="text-error small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="BloodType" class="label-sm mb-1">Blood Type</label>
                                <select asp-for="BloodType" class="input-field">
                                    <option value="Unknown" style="background: var(--surface); color: var(--on-surface);">Unknown</option>
                                    <option value="A_Positive" style="background: var(--surface); color: var(--on-surface);">A+</option>
                                    <option value="A_Negative" style="background: var(--surface); color: var(--on-surface);">A-</option>
                                    <option value="B_Positive" style="background: var(--surface); color: var(--on-surface);">B+</option>
                                    <option value="B_Negative" style="background: var(--surface); color: var(--on-surface);">B-</option>
                                    <option value="AB_Positive" style="background: var(--surface); color: var(--on-surface);">AB+</option>
                                    <option value="AB_Negative" style="background: var(--surface); color: var(--on-surface);">AB-</option>
                                    <option value="O_Positive" style="background: var(--surface); color: var(--on-surface);">O+</option>
                                    <option value="O_Negative" style="background: var(--surface); color: var(--on-surface);">O-</option>
                                </select>
                                <span asp-validation-for="BloodType" class="text-error small"></span>
                            </div>
                            <div class="col-md-12">
                                <label asp-for="Notes" class="label-sm mb-1">Medical Notes / Conditions</label>
                                <textarea asp-for="Notes" rows="3" class="input-field"></textarea>
                                <span asp-validation-for="Notes" class="text-error small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-3 mt-5">
                            <a asp-action="Profile" class="btn-secondary px-4 py-2 text-decoration-none">Cancel</a>
                            <button type="submit" class="ke-btn ke-btn-primary px-4 py-2">
                                Save Profile
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
