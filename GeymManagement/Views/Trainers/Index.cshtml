@model IEnumerable<TrainerIndexViewModel>
@{
    ViewData["Title"] = "Trainers";
}

<div class="container py-5">
    <div class="ke-header-content mb-5 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="ke-header-text">
            <h1 class="ke-title">OUR TRAINERS</h1>
            <p class="ke-subtitle">Professional fitness instructors</p>
        </div>
        <a asp-controller="Trainers" asp-action="Create" class="ke-btn ke-btn-primary px-4 py-2">
            <span class="fs-5 fw-bold me-2">+</span> Add Trainer
        </a>
    </div>

    @if (TempData[TempDataKeys.SuccessMessage] != null)
    {
        <div class="mb-4 p-3 border-structural bg-surface d-flex align-items-center" style="border-left-color: var(--primary);">
            <i class="bi bi-check-circle-fill text-primary fs-4 me-3"></i>
            <span class="body-md">@TempData[TempDataKeys.SuccessMessage]</span>
        </div>
    }
    else if (TempData[TempDataKeys.ErrorMessage] != null)
    {
        <div class="mb-4 p-3 border-structural bg-surface d-flex align-items-center" style="border-left-color: var(--error);">
            <i class="bi bi-exclamation-triangle-fill text-error fs-4 me-3"></i>
            <span class="body-md text-error">@TempData[TempDataKeys.ErrorMessage]</span>
        </div>
    }

    @if (Model.Any())
    {
        <div class="card card-elevated table-responsive">
            <table class="table table-hover mb-0 align-middle bg-transparent">
                <thead>
                    <tr class="border-bottom border-structural">
                        <th class="label-sm text-muted p-4">Name</th>
                        <th class="label-sm text-muted p-4">Email</th>
                        <th class="label-sm text-muted p-4">Phone</th>
                        <th class="label-sm text-muted p-4">Specialization</th>
                        <th class="label-sm text-muted p-4">Actions</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var trainer in Model)
                    {
                        var spec = trainer.Specialization.ToLower();
                        var specColor = spec switch {
                            "cardio" => "var(--error)",
                            "balance" => "var(--ice, var(--ice))",
                            "boxing" => "var(--primary)",
                            "yoga" => "var(--lime, #84cc16)",
                            "crossfit" => "var(--warning, var(--gold))",
                            "fitness" => "var(--purple, #a855f7)",
                            _ => "var(--text-muted)"
                        };

                        <tr class="border-bottom border-structural">
                            <td class="p-4 body-md fw-bold text-on-surface">@trainer.Name</td>
                            <td class="p-4 body-md data-mono text-muted">@trainer.Email</td>
                            <td class="p-4 body-md data-mono text-muted">@trainer.Phone</td>
                            <td class="p-4">
                                <span class="d-inline-block px-3 py-1 label-sm data-mono" style="border: 2px solid @specColor; color: @specColor; background: var(--surface-container-high);">
                                    @trainer.Specialization
                                </span>
                            </td>
                            <td class="p-4">
                                <div class="d-flex gap-2">
                                    <a asp-controller="Trainers" asp-action="Details" asp-route-id="@trainer.Id" class="btn-secondary px-3 py-1" title="View Details">
                                        View
                                    </a>
                                    <a asp-controller="Trainers" asp-action="Edit" asp-route-id="@trainer.Id" class="ke-btn ke-btn-primary px-3 py-1" title="Edit">
                                        Edit
                                    </a>
                                    <a asp-controller="Trainers" asp-action="Delete" asp-route-id="@trainer.Id" class="btn-secondary px-3 py-1 text-error" style="border-color: var(--error);" title="Delete">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card card-elevated p-5 text-center">
            <div class="display-lg mb-3">🏋️</div>
            <h2 class="display-md mb-2">No Trainers Available</h2>
            <p class="body-md text-muted mb-4">Add your first trainer to get started</p>
            <a asp-controller="Trainers" asp-action="Create" class="ke-btn ke-btn-primary px-4 py-2 d-inline-block mx-auto" style="width: fit-content;">
                <span class="fs-5 fw-bold me-2">+</span> Add First Trainer
            </a>
        </div>
    }
</div>

@section Scripts {
    <partial name="_AlertDismissScript"/>
}
