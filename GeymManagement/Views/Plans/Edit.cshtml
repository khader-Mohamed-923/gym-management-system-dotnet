@model EditPlanViewModel

@{
    ViewData["Title"] = "Edit Plan";
}

<div class="container py-5">
    <div class="ke-header-content mb-5">
        <div class="ke-header-text">
            <h1 class="ke-title">PLAN — EDIT PAGE</h1>
            <p class="ke-subtitle">Update membership plan details</p>
        </div>
    </div>

    @if (TempData[TempDataKeys.SuccessMessage] != null)
    {
        <div class="mb-4 p-3 border-structural bg-surface d-flex align-items-center" style="border-left-color: var(--primary);">
            <i class="bi bi-check-circle-fill text-primary fs-4 me-3"></i>
            <span class="body-md">@TempData[TempDataKeys.SuccessMessage]</span>
        </div>
    }
    else if (TempData[TempDataKeys.ErrorMessage] != null)
    {
        <div class="mb-4 p-3 border-structural bg-surface d-flex align-items-center" style="border-left-color: var(--error);">
            <i class="bi bi-exclamation-triangle-fill text-error fs-4 me-3"></i>
            <span class="body-md text-error">@TempData[TempDataKeys.ErrorMessage]</span>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card card-elevated">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="PlanName" />

                        <div class="mb-5 p-4 border-structural bg-surface" style="border-left-color: var(--primary);">
                            <label class="label-sm mb-2 d-flex align-items-center gap-2">
                                <i class="bi bi-lock-fill"></i> PLAN NAME (LOCKED)
                            </label>
                            <div class="d-flex align-items-center gap-2 px-3 py-2 bg-background border-structural">
                                <span class="text-muted"><i class="bi bi-tag"></i></span>
                                <span class="body-md fw-bold">@Model.PlanName</span>
                            </div>
                            <span class="small text-muted mt-2 d-block">
                                Plan name cannot be modified to maintain data integrity and member references.
                            </span>
                        </div>

                        <h3 class="ke-section-header text-primary pb-2 border-bottom border-structural mb-4">
                            EDITABLE FIELDS
                        </h3>

                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label asp-for="DurationInDays" class="label-sm mb-1">DURATION (DAYS) <span class="text-error">*</span></label>
                                <input asp-for="DurationInDays" 
                                       class="input-field" 
                                       type="number"
                                       min="1"
                                       placeholder="Enter duration in days" />
                                <span asp-validation-for="DurationInDays" class="text-error small mt-1"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Price" class="label-sm mb-1">PRICE (EGP) <span class="text-error">*</span></label>
                                <input asp-for="Price" 
                                       class="input-field" 
                                       type="number"
                                       step="0.01"
                                       min="0.01"
                                       placeholder="Enter price in EGP" />
                                <span asp-validation-for="Price" class="text-error small mt-1"></span>
                            </div>
                        </div>

                        <div class="mb-5">
                            <label asp-for="Description" class="label-sm mb-1">DESCRIPTION <span class="text-error">*</span></label>
                            <textarea asp-for="Description" 
                                      class="input-field" 
                                      rows="4"
                                      placeholder="Enter plan description"></textarea>
                            <span asp-validation-for="Description" class="text-error small mt-1"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-3 pt-4 border-top border-structural">
                            <a asp-action="Index" class="btn-secondary px-4 py-2 text-decoration-none">
                                Cancel
                            </a>
                            <button type="submit" class="ke-btn ke-btn-primary px-4 py-2">
                                Update Plan
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_AlertDismissScript" />
}
