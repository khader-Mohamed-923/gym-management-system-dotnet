@model IEnumerable<SessionIndexViewModel>

@{
    ViewData["Title"] = "Sessions";
}

<div class="container py-5">
    <div class="ke-header-content mb-5 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="ke-header-text">
            <h1 class="ke-title">SESSIONS</h1>
            <p class="ke-subtitle">Manage gym training sessions and classes</p>
        </div>
        <a asp-controller="Sessions" asp-action="Create" class="ke-btn ke-btn-primary px-4 py-2">
            <span class="fs-5 fw-bold me-2">+</span> Add Session
        </a>
    </div>

    @if (TempData[TempDataKeys.SuccessMessage] != null)
    {
        <div class="mb-4 p-3 border-structural bg-surface d-flex align-items-center" style="border-left-color: var(--primary);">
            <i class="bi bi-check-circle-fill text-primary fs-4 me-3"></i>
            <span class="body-md">@TempData[TempDataKeys.SuccessMessage]</span>
        </div>
    }
    else if (TempData[TempDataKeys.ErrorMessage] != null)
    {
        <div class="mb-4 p-3 border-structural bg-surface d-flex align-items-center" style="border-left-color: var(--error);">
            <i class="bi bi-exclamation-triangle-fill text-error fs-4 me-3"></i>
            <span class="body-md text-error">@TempData[TempDataKeys.ErrorMessage]</span>
        </div>
    }

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var session in Model)
            {
                var statusColor = session.Status.ToString().ToLower() switch {
                    "upcoming" => "var(--ice, var(--ice))",
                    "ongoing" => "var(--lime, #84cc16)",
                    _ => "var(--text-muted)"
                };

                <div class="col-lg-4 col-md-6">
                    <div class="card card-elevated h-100 d-flex flex-column">
                        <div class="p-3 border-bottom border-structural d-flex justify-content-between align-items-center">
                            <span class="d-inline-block px-3 py-1 label-sm data-mono" style="border: 2px solid var(--primary); color: var(--primary); background: var(--surface-container-high);">
                                @session.CategoryName
                            </span>
                            <span class="d-inline-flex align-items-center gap-2 label-sm data-mono" style="color: @statusColor;">
                                <span style="width: 6px; height: 6px; border-radius: 50%; background: currentColor;"></span>
                                @session.Status
                            </span>
                        </div>

                        <div class="p-3 flex-grow-1 d-flex flex-column">
                            <h3 class="body-lg fw-bold text-on-surface mb-3">@session.Description</h3>
                            
                            <div class="row g-3 flex-grow-1">
                                <div class="col-6">
                                    <div class="p-2 bg-surface border-structural h-100">
                                        <div class="label-sm text-muted mb-1"><i class="bi bi-person me-1"></i>Trainer</div>
                                        <div class="body-sm text-on-surface fw-bold text-truncate" title="@session.TrainerName">@session.TrainerName</div>
                                    </div>
                                </div>
                                
                                <div class="col-6">
                                    <div class="p-2 bg-surface border-structural h-100">
                                        <div class="label-sm text-muted mb-1"><i class="bi bi-calendar me-1"></i>Date</div>
                                        <div class="body-sm data-mono text-primary">@session.StartDate.ToString("MMM dd, yyyy")</div>
                                    </div>
                                </div>
                                
                                <div class="col-6">
                                    <div class="p-2 bg-surface border-structural h-100">
                                        <div class="label-sm text-muted mb-1"><i class="bi bi-clock me-1"></i>Time</div>
                                        <div class="body-sm data-mono text-primary">@session.StartDate.ToString("HH:mm") - @session.EndDate.ToString("HH:mm")</div>
                                    </div>
                                </div>
                                
                                <div class="col-6">
                                    <div class="p-2 bg-surface border-structural h-100">
                                        <div class="label-sm text-muted mb-1"><i class="bi bi-people me-1"></i>Capacity</div>
                                        <div class="body-sm data-mono text-primary">@session.BookedCount/@session.Capacity slots</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="p-3 border-top border-structural bg-surface mt-auto">
                            <div class="d-flex gap-2">
                                <a asp-controller="Sessions" asp-action="Details" asp-route-id="@session.Id" class="btn-secondary flex-grow-1 py-2 text-center text-decoration-none">
                                    View
                                </a>
                                <a asp-controller="Sessions" asp-action="Edit" asp-route-id="@session.Id" class="ke-btn ke-btn-primary flex-grow-1 py-2 text-center text-decoration-none">
                                    Edit
                                </a>
                                <a asp-controller="Sessions" asp-action="Delete" asp-route-id="@session.Id" class="btn-secondary flex-grow-1 py-2 text-center text-error text-decoration-none" style="border-color: var(--error);">
                                    Delete
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card card-elevated p-5 text-center">
            <div class="display-lg mb-3">🗓️</div>
            <h2 class="display-md mb-2">No Sessions Available</h2>
            <p class="body-md text-muted mb-4">Schedule your first training session</p>
            <a asp-controller="Sessions" asp-action="Create" class="ke-btn ke-btn-primary px-4 py-2 d-inline-block mx-auto" style="width: fit-content;">
                <span class="fs-5 fw-bold me-2">+</span> Create First Session
            </a>
        </div>
    }
</div>

@section Scripts {
    <partial name="_AlertDismissScript"/>
}

