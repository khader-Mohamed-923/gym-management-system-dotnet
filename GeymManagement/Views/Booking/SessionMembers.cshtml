@model SessionMembersViewModel

@{
    ViewData["Title"] = "Session Members";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-5">
    <div class="ke-header-content mb-4">
        <a asp-controller="Booking" asp-action="Schedule" class="btn-secondary px-3 py-1 mb-3 text-decoration-none d-inline-block">
            ← Back to Schedule
        </a>
        <div class="ke-header-text">
            <h1 class="ke-title">SESSION MEMBERS</h1>
            <p class="ke-subtitle">View and manage attendance for this session</p>
        </div>
    </div>

    <!-- Session Info Card -->
    <div class="card card-elevated p-4 mb-5">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4 pb-3 border-bottom border-structural">
            <div>
                <h2 class="display-sm text-primary mb-2">@Model.SessionName</h2>
                @if (Model.Status.ToString().ToLower() == "upcoming")
                {
                    <span class="d-inline-flex align-items-center gap-2 label-sm data-mono text-muted">
                        <span style="width: 6px; height: 6px; border-radius: 50%; background: currentColor;"></span> @Model.Status
                    </span>
                }
                else if (Model.Status.ToString().ToLower() == "ongoing")
                {
                    <span class="d-inline-flex align-items-center gap-2 label-sm data-mono" style="color: var(--lime);">
                        <span style="width: 6px; height: 6px; border-radius: 50%; background: currentColor;"></span> @Model.Status
                    </span>
                }
                else
                {
                    <span class="d-inline-flex align-items-center gap-2 label-sm data-mono text-muted">
                        <span style="width: 6px; height: 6px; border-radius: 50%; background: currentColor;"></span> @Model.Status
                    </span>
                }
            </div>
            <div class="d-inline-flex align-items-center gap-2 px-3 py-2 label-sm data-mono" style="border: 1px solid var(--primary); color: var(--primary); background: var(--surface-container-high);">
                <i class="bi bi-person-badge"></i> @Model.TrainerName
            </div>
        </div>
        
        <div class="row g-4">
            <div class="col-6 col-md-3">
                <div class="d-flex flex-column gap-1">
                    <span class="label-sm text-muted d-flex align-items-center gap-2"><i class="bi bi-calendar3"></i> Date</span>
                    <span class="body-md text-on-surface data-mono">@Model.StartDate.ToString("MMM dd, yyyy")</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="d-flex flex-column gap-1">
                    <span class="label-sm text-muted d-flex align-items-center gap-2"><i class="bi bi-clock"></i> Time</span>
                    <span class="body-md text-on-surface data-mono">@Model.StartDate.ToString("HH:mm") - @Model.EndDate.ToString("HH:mm")</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="d-flex flex-column gap-1">
                    <span class="label-sm text-muted d-flex align-items-center gap-2"><i class="bi bi-stopwatch"></i> Duration</span>
                    <span class="body-md text-on-surface data-mono">@((int)(Model.EndDate - Model.StartDate).TotalMinutes) min</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="d-flex flex-column gap-1">
                    <span class="label-sm text-muted d-flex align-items-center gap-2"><i class="bi bi-people"></i> Members</span>
                    <span class="body-md text-on-surface data-mono">@Model.Members.Count()</span>
                </div>
            </div>
        </div>
    </div>

    @if (TempData[TempDataKeys.SuccessMessage] != null)
    {
        <div class="mb-4 p-3 border-structural bg-surface d-flex align-items-center" style="border-left-color: var(--primary);">
            <i class="bi bi-check-circle-fill text-primary fs-4 me-3"></i>
            <span class="body-md">@TempData[TempDataKeys.SuccessMessage]</span>
        </div>
    }
    else if (TempData[TempDataKeys.ErrorMessage] != null)
    {
        <div class="mb-4 p-3 border-structural bg-surface d-flex align-items-center" style="border-left-color: var(--error);">
            <i class="bi bi-exclamation-triangle-fill text-error fs-4 me-3"></i>
            <span class="body-md text-error">@TempData[TempDataKeys.ErrorMessage]</span>
        </div>
    }

    @if (Model.Members.Any())
    {
        <div class="card card-elevated" style="padding: 0; overflow: hidden;">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0" style="--bs-table-bg: var(--surface); --bs-table-color: var(--on-surface);">
                    <thead style="border-bottom: 2px solid var(--border-color);">
                        <tr>
                            <th class="label-sm text-muted p-3">Member</th>
                            <th class="label-sm text-muted p-3">Email</th>
                            <th class="label-sm text-muted p-3">Phone</th>
                            <th class="label-sm text-muted p-3">Booking Date</th>
                            <th class="label-sm text-muted p-3">Attendance</th>
                            @if (Model.Status == SessionStatus.Ongoing || Model.Status == SessionStatus.Completed)
                            {
                                <th class="label-sm text-muted p-3">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var member in Model.Members)
                        {
                            <tr style="border-bottom: 1px solid var(--border-color);">
                                <td class="p-3 align-middle">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="d-flex align-items-center justify-content-center bg-background border-structural" style="width: 40px; height: 40px;">
                                            <i class="bi bi-person-fill text-primary"></i>
                                        </div>
                                        <div>
                                            <div class="body-md fw-bold text-on-surface">@member.MemberName</div>
                                            <div class="label-sm text-muted">ID: @member.MemberId</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="p-3 align-middle body-md text-on-surface">@member.MemberEmail</td>
                                <td class="p-3 align-middle body-md text-on-surface data-mono">@member.MemberPhone</td>
                                <td class="p-3 align-middle body-sm text-muted data-mono">@member.BookingDate.ToString("MMM dd, yyyy HH:mm")</td>
                                <td class="p-3 align-middle">
                                    @if (member.IsAttended)
                                    {
                                        <span class="d-inline-flex align-items-center gap-2 px-2 py-1 label-sm data-mono" style="border: 1px solid var(--lime); color: var(--lime); background: var(--surface-container-high);">
                                            <i class="bi bi-check-circle-fill"></i> Attended
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="d-inline-flex align-items-center gap-2 px-2 py-1 label-sm data-mono text-muted" style="border: 1px solid var(--text-muted); background: var(--surface-container-high);">
                                            <i class="bi bi-clock"></i> Pending
                                        </span>
                                    }
                                </td>
                                @if (Model.Status == SessionStatus.Ongoing || Model.Status == SessionStatus.Completed)
                                {
                                    <td class="p-3 align-middle">
                                        <div class="d-flex gap-2">
                                            @if (!member.IsAttended)
                                            {
                                                <button class="ke-btn py-1 px-3 label-sm" style="background: var(--lime); border-color: var(--lime); color: #000;" onclick="markAttendance(@member.BookingId, true)">
                                                    Mark Present
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn-secondary py-1 px-3 label-sm text-error" style="border-color: var(--error);" onclick="markAttendance(@member.BookingId, false)">
                                                    Mark Absent
                                                </button>
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card card-elevated p-5 text-center">
            <div class="display-lg mb-3">👥</div>
            <h3 class="display-md mb-2 text-on-surface">No Members Booked</h3>
            <p class="body-md text-muted m-0">No members have booked this session yet.</p>
        </div>
    }
</div>

@section Scripts {
    <partial name="_AlertDismissScript"/>
    <script>
        function markAttendance(bookingId, attended) {
            fetch('@Url.Action("MarkAttendance", "Booking")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                body: 'bookingId=' + bookingId + '&attended=' + attended
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.message);
                }
            })
            .catch(error => {
                alert('An error occurred. Please try again.');
            });
        }
    </script>
}


