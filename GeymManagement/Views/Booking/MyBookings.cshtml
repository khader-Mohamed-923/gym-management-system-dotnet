@model IEnumerable<BookingViewModel>

@{
    ViewData["Title"] = "My Bookings";
    Layout = "~/Views/Shared/_MemberLayout.cshtml";
}

<div class="container py-5">
    <div class="ke-header-content mb-5 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="ke-header-text">
            <h1 class="ke-title">MY BOOKINGS</h1>
            <p class="ke-subtitle">View and manage your session bookings</p>
        </div>
        <a asp-controller="Booking" asp-action="Schedule" class="ke-btn ke-btn-primary px-4 py-2 text-decoration-none">
            <span class="fw-bold me-2">+</span> Browse Sessions
        </a>
    </div>

    @if (TempData[TempDataKeys.SuccessMessage] != null)
    {
        <div class="mb-4 p-3 border-structural bg-surface d-flex align-items-center" style="border-left-color: var(--primary);">
            <i class="bi bi-check-circle-fill text-primary fs-4 me-3"></i>
            <span class="body-md">@TempData[TempDataKeys.SuccessMessage]</span>
        </div>
    }
    else if (TempData[TempDataKeys.ErrorMessage] != null)
    {
        <div class="mb-4 p-3 border-structural bg-surface d-flex align-items-center" style="border-left-color: var(--error);">
            <i class="bi bi-exclamation-triangle-fill text-error fs-4 me-3"></i>
            <span class="body-md text-error">@TempData[TempDataKeys.ErrorMessage]</span>
        </div>
    }

    @if (Model.Any())
    {
        <div class="d-flex flex-column gap-4">
            @foreach (var booking in Model)
            {
                var isPast = booking.EndDate < DateTime.Now;
                
                <div class="card card-elevated @(isPast ? "opacity-75" : "")">
                    <div class="p-3 border-bottom border-structural d-flex justify-content-between align-items-center flex-wrap gap-3" style="@(isPast ? "filter: grayscale(1);" : "")">
                        <div class="d-flex align-items-center gap-3">
                            <div class="d-flex align-items-center justify-content-center bg-background border-structural" style="width: 48px; height: 48px;">
                                <i class="bi bi-activity text-primary fs-4"></i>
                            </div>
                            <div>
                                <h3 class="body-lg fw-bold m-0 mb-1 text-on-surface">@booking.SessionName</h3>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="d-inline-block px-2 py-1 label-sm data-mono" style="border: 1px solid var(--primary); color: var(--primary); background: var(--surface-container-high);">
                                        @booking.CategoryName
                                    </span>
                                    @if (booking.Status.ToString().ToLower() == "upcoming")
                                    {
                                        <span class="d-inline-flex align-items-center gap-2 label-sm data-mono" style="color: var(--ice);">
                                            <span style="width: 6px; height: 6px; border-radius: 50%; background: currentColor;"></span> @booking.Status
                                        </span>
                                    }
                                    else if (booking.Status.ToString().ToLower() == "ongoing")
                                    {
                                        <span class="d-inline-flex align-items-center gap-2 label-sm data-mono" style="color: var(--lime);">
                                            <span style="width: 6px; height: 6px; border-radius: 50%; background: currentColor;"></span> @booking.Status
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="d-inline-flex align-items-center gap-2 label-sm data-mono text-muted">
                                            <span style="width: 6px; height: 6px; border-radius: 50%; background: currentColor;"></span> @booking.Status
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div>
                            @if (!isPast)
                            {
                                <button class="btn-secondary px-3 py-1 text-error" style="border-color: var(--error);" onclick="cancelBooking(@booking.BookingId)">
                                    <i class="bi bi-x-circle me-1"></i> Cancel
                                </button>
                            }
                        </div>
                    </div>

                    <div class="p-3 bg-surface">
                        <div class="row g-3 mb-3">
                            <div class="col-6 col-md-3">
                                <div class="d-flex flex-column gap-1">
                                    <span class="label-sm text-muted d-flex align-items-center gap-2"><i class="bi bi-person-badge"></i> Trainer</span>
                                    <span class="body-sm text-primary fw-bold">@booking.TrainerName</span>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="d-flex flex-column gap-1">
                                    <span class="label-sm text-muted d-flex align-items-center gap-2"><i class="bi bi-calendar3"></i> Date</span>
                                    <span class="body-sm text-on-surface data-mono">@booking.StartDate.ToString("MMM dd, yyyy")</span>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="d-flex flex-column gap-1">
                                    <span class="label-sm text-muted d-flex align-items-center gap-2"><i class="bi bi-clock"></i> Time</span>
                                    <span class="body-sm text-on-surface data-mono">@booking.StartDate.ToString("HH:mm") - @booking.EndDate.ToString("HH:mm")</span>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="d-flex flex-column gap-1">
                                    <span class="label-sm text-muted d-flex align-items-center gap-2"><i class="bi bi-stopwatch"></i> Duration</span>
                                    <span class="body-sm text-on-surface data-mono">@booking.DurationMinutes min</span>
                                </div>
                            </div>
                        </div>

                        @if (isPast)
                        {
                            <div class="pt-3 border-top border-structural text-end">
                                @if (booking.IsAttended)
                                {
                                    <span class="d-inline-flex align-items-center gap-2 px-3 py-2 label-sm data-mono" style="border: 2px solid var(--lime); color: var(--lime); background: var(--surface-container-high);">
                                        <i class="bi bi-check-circle-fill"></i> ATTENDED
                                    </span>
                                }
                                else
                                {
                                    <span class="d-inline-flex align-items-center gap-2 px-3 py-2 label-sm data-mono" style="border: 2px solid var(--error); color: var(--error); background: var(--surface-container-high);">
                                        <i class="bi bi-x-circle-fill"></i> MISSED
                                    </span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card card-elevated p-5 text-center">
            <div class="display-lg mb-3">📅</div>
            <h2 class="display-md mb-2 text-on-surface">No Bookings Yet</h2>
            <p class="body-md text-muted mb-4">You haven't booked any sessions yet. Browse available sessions to get started!</p>
            <a asp-controller="Booking" asp-action="Schedule" class="ke-btn ke-btn-primary px-4 py-2 d-inline-block mx-auto text-decoration-none" style="width: fit-content;">
                <span class="fw-bold me-2">+</span> Browse Sessions
            </a>
        </div>
    }
</div>

@section Scripts {
    <partial name="_AlertDismissScript"/>
    <script>
        function cancelBooking(bookingId) {
            if (!confirm('Are you sure you want to cancel this booking?')) {
                return;
            }
            
            fetch('@Url.Action("Cancel", "Booking")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                body: 'bookingId=' + bookingId
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.message);
                }
            })
            .catch(error => {
                alert('An error occurred. Please try again.');
            });
        }
    </script>
}

