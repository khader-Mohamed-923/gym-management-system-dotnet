@using GymManagement.Domain.Enums
@using System.Security.Claims
@model ScheduleViewModel

@{
    ViewData["Title"] = "Sessions Schedule";
    var userRole = User?.FindFirst(ClaimTypes.Role)?.Value;
    var isAdmin = userRole == nameof(Role.Admin);
    var isTrainer = userRole == nameof(Role.Trainer);
    var isMember = userRole == nameof(Role.Member);

    if (isMember)
    {
        Layout = "~/Views/Shared/_MemberLayout.cshtml";
    }
    else if (isTrainer)
    {
        Layout = "~/Views/Shared/_TrainerLayout.cshtml";
    }
    else if (isAdmin)
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
}

<div class="container py-5">
    <div class="ke-header-content mb-5">
        <div class="ke-header-text">
            <h1 class="ke-title">SESSIONS SCHEDULE</h1>
            <p class="ke-subtitle">View and manage upcoming and ongoing sessions</p>
        </div>
    </div>

    @Html.AntiForgeryToken()
    @if (TempData[TempDataKeys.SuccessMessage] != null)
    {
        <div class="mb-4 p-3 border-structural bg-surface d-flex align-items-center" style="border-left-color: var(--primary);">
            <i class="bi bi-check-circle-fill text-primary fs-4 me-3"></i>
            <span class="body-md">@TempData[TempDataKeys.SuccessMessage]</span>
        </div>
    }
    else if (TempData[TempDataKeys.ErrorMessage] != null)
    {
        <div class="mb-4 p-3 border-structural bg-surface d-flex align-items-center" style="border-left-color: var(--error);">
            <i class="bi bi-exclamation-triangle-fill text-error fs-4 me-3"></i>
            <span class="body-md text-error">@TempData[TempDataKeys.ErrorMessage]</span>
        </div>
    }

    <!-- Upcoming Sessions Section -->
    <div class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-structural">
            <div>
                <h2 class="display-md text-primary m-0">
                    <i class="bi bi-calendar-event me-2"></i>Upcoming Sessions
                </h2>
                <p class="body-sm text-muted mt-2 mb-0">Sessions available for booking</p>
            </div>
        </div>

        @if (Model.UpcomingSessions.Any())
        {
            <div class="row g-4">
                @foreach (var session in Model.UpcomingSessions)
                {
                    var isFull = session.BookedCount >= session.Capacity;
                    <div class="col-md-6 col-lg-4">
                        <div class="card card-elevated h-100 d-flex flex-column" data-session-id="@session.SessionId">
                            <div class="p-3 border-bottom border-structural d-flex justify-content-between align-items-start gap-3">
                                <div class="d-flex gap-3 w-100">
                                    <div class="d-flex align-items-center justify-content-center bg-background border-structural flex-shrink-0" style="width: 48px; height: 48px;">
                                        <i class="bi bi-activity text-primary fs-4"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h3 class="body-lg fw-bold m-0 mb-1 text-on-surface">@session.SessionName</h3>
                                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                            <span class="d-inline-block px-2 py-1 label-sm data-mono" style="border: 1px solid var(--primary); color: var(--primary); background: var(--surface-container-high);">
                                                @session.CategoryName
                                            </span>
                                            <span class="d-inline-flex align-items-center gap-2 label-sm data-mono text-muted">
                                                <span style="width: 6px; height: 6px; border-radius: 50%; background: currentColor;"></span> Upcoming
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="p-3 flex-grow-1 bg-surface d-flex flex-column gap-2">
                                <div class="d-flex justify-content-between align-items-center border-bottom border-structural pb-2">
                                    <span class="label-sm text-muted d-flex align-items-center gap-2"><i class="bi bi-person-badge"></i> Trainer</span>
                                    <span class="body-sm text-on-surface">@session.TrainerName</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center border-bottom border-structural pb-2">
                                    <span class="label-sm text-muted d-flex align-items-center gap-2"><i class="bi bi-calendar3"></i> Date</span>
                                    <span class="body-sm text-on-surface data-mono">@session.StartDate.ToString("MMM dd, yyyy")</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center border-bottom border-structural pb-2">
                                    <span class="label-sm text-muted d-flex align-items-center gap-2"><i class="bi bi-clock"></i> Time</span>
                                    <span class="body-sm text-on-surface data-mono">@session.StartDate.ToString("HH:mm") - @session.EndDate.ToString("HH:mm")</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center border-bottom border-structural pb-2">
                                    <span class="label-sm text-muted d-flex align-items-center gap-2"><i class="bi bi-stopwatch"></i> Duration</span>
                                    <span class="body-sm text-on-surface data-mono">@session.DurationMinutes min</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center pb-2">
                                    <span class="label-sm text-muted d-flex align-items-center gap-2"><i class="bi bi-people"></i> Capacity</span>
                                    <span class="body-sm data-mono @(isFull ? "text-error" : "text-on-surface")">@session.BookedCount/@session.Capacity slots</span>
                                </div>
                            </div>

                            <div class="p-3 border-top border-structural bg-surface mt-auto d-flex justify-content-center gap-2 flex-wrap">
                                @if (isAdmin || isTrainer)
                                {
                                    <a asp-controller="Booking" asp-action="SessionMembers" asp-route-sessionId="@session.SessionId" 
                                       class="btn-secondary w-100 py-2 text-decoration-none text-center">
                                        <i class="bi bi-people me-1"></i> View Members
                                    </a>
                                }
                                else if (isMember)
                                {
                                    if (session.IsBookedByCurrentUser)
                                    {
                                        <span class="d-inline-flex align-items-center gap-2 px-3 py-2 label-sm data-mono" style="border: 2px solid var(--lime); color: var(--lime); background: var(--surface-container-high);">
                                            <i class="bi bi-check-circle-fill"></i> BOOKED
                                        </span>
                                        <button class="btn-secondary px-3 py-1 text-error ms-2" style="border-color: var(--error);" onclick="cancelBooking(@session.CurrentUserBookingId, @session.SessionId, this)">
                                            <i class="bi bi-x-circle me-1"></i> Cancel
                                        </button>
                                    }
                                    else if (isFull)
                                    {
                                        <span class="d-inline-flex align-items-center gap-2 px-3 py-2 label-sm data-mono w-100 justify-content-center" style="border: 2px solid var(--error); color: var(--error); background: var(--surface-container-high);">
                                            <i class="bi bi-exclamation-circle me-1"></i> FULL
                                        </span>
                                    }
                                    else
                                    {
                                        <button class="ke-btn ke-btn-primary w-100 py-2 d-flex justify-content-center align-items-center gap-2" onclick="bookSession(@session.SessionId, this)">
                                            <i class="bi bi-plus-circle"></i> Book Now
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card card-elevated p-5 text-center">
                <div class="display-lg mb-3">📅</div>
                <h3 class="display-md mb-2 text-on-surface">No Upcoming Sessions</h3>
                <p class="body-md text-muted m-0">There are no upcoming sessions scheduled.</p>
            </div>
        }
    </div>

    <!-- Ongoing Sessions Section -->
    <div class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-structural">
            <div>
                <h2 class="display-md text-primary m-0" style="color: var(--lime) !important;">
                    <i class="bi bi-play-circle me-2"></i>Ongoing Sessions
                </h2>
                <p class="body-sm text-muted mt-2 mb-0">Sessions currently in progress</p>
            </div>
        </div>

        @if (Model.OngoingSessions.Any())
        {
            <div class="row g-4">
                @foreach (var session in Model.OngoingSessions)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card card-elevated h-100 d-flex flex-column" data-session-id="@session.SessionId" style="border-color: var(--lime);">
                            <div class="p-3 border-bottom border-structural d-flex justify-content-between align-items-start gap-3" style="background: rgba(34, 197, 94, 0.05);">
                                <div class="d-flex gap-3 w-100">
                                    <div class="d-flex align-items-center justify-content-center bg-background border-structural flex-shrink-0" style="width: 48px; height: 48px; border-color: var(--lime);">
                                        <i class="bi bi-activity text-lime fs-4" style="color: var(--lime);"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h3 class="body-lg fw-bold m-0 mb-1 text-on-surface">@session.SessionName</h3>
                                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                            <span class="d-inline-block px-2 py-1 label-sm data-mono" style="border: 1px solid var(--lime); color: var(--lime); background: var(--surface-container-high);">
                                                @session.CategoryName
                                            </span>
                                            <span class="d-inline-flex align-items-center gap-2 label-sm data-mono" style="color: var(--lime);">
                                                <span style="width: 6px; height: 6px; border-radius: 50%; background: currentColor;"></span> Ongoing
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="p-3 flex-grow-1 bg-surface d-flex flex-column gap-2">
                                <div class="d-flex justify-content-between align-items-center border-bottom border-structural pb-2">
                                    <span class="label-sm text-muted d-flex align-items-center gap-2"><i class="bi bi-person-badge"></i> Trainer</span>
                                    <span class="body-sm text-on-surface">@session.TrainerName</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center border-bottom border-structural pb-2">
                                    <span class="label-sm text-muted d-flex align-items-center gap-2"><i class="bi bi-calendar3"></i> Date</span>
                                    <span class="body-sm text-on-surface data-mono">@session.StartDate.ToString("MMM dd, yyyy")</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center border-bottom border-structural pb-2">
                                    <span class="label-sm text-muted d-flex align-items-center gap-2"><i class="bi bi-clock"></i> Time</span>
                                    <span class="body-sm text-on-surface data-mono">@session.StartDate.ToString("HH:mm") - @session.EndDate.ToString("HH:mm")</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center border-bottom border-structural pb-2">
                                    <span class="label-sm text-muted d-flex align-items-center gap-2"><i class="bi bi-stopwatch"></i> Duration</span>
                                    <span class="body-sm text-on-surface data-mono">@session.DurationMinutes min</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center pb-2">
                                    <span class="label-sm text-muted d-flex align-items-center gap-2"><i class="bi bi-people"></i> Capacity</span>
                                    <span class="body-sm data-mono text-on-surface">@session.BookedCount/@session.Capacity slots</span>
                                </div>
                            </div>

                            <div class="p-3 border-top border-structural bg-surface mt-auto d-flex justify-content-center gap-2 flex-wrap">
                                @if (isAdmin || isTrainer)
                                {
                                    <a asp-controller="Booking" asp-action="SessionMembers" asp-route-sessionId="@session.SessionId" 
                                       class="ke-btn w-100 py-2 text-decoration-none text-center" style="background: var(--lime); border-color: var(--lime); color: #000;">
                                        <i class="bi bi-people me-1"></i> View Members
                                    </a>
                                }
                                else if (isMember)
                                {
                                    @if (session.IsBookedByCurrentUser)
                                    {
                                        <span class="d-inline-flex align-items-center gap-2 px-3 py-2 label-sm data-mono w-100 justify-content-center" style="border: 2px solid var(--lime); color: var(--lime); background: var(--surface-container-high);">
                                            <i class="bi bi-check-circle-fill me-1"></i> YOU'RE BOOKED
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="d-inline-flex align-items-center gap-2 px-3 py-2 label-sm data-mono w-100 justify-content-center" style="border: 2px solid var(--primary); color: var(--primary); background: var(--surface-container-high);">
                                            <i class="bi bi-info-circle me-1"></i> IN PROGRESS
                                        </span>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card card-elevated p-5 text-center">
                <div class="display-lg mb-3">🏃</div>
                <h3 class="display-md mb-2 text-on-surface">No Ongoing Sessions</h3>
                <p class="body-md text-muted m-0">There are no sessions currently in progress.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_AlertDismissScript"/>
    <script>
        function dismissAlert(btn) {
            btn.parentElement.remove();
        }

        function bookSession(sessionId, btnElement) {
            // Visual loading state
            const originalHtml = btnElement.innerHTML;
            btnElement.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Booking...';
            btnElement.disabled = true;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            fetch('@Url.Action("Book", "Booking")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: 'sessionId=' + sessionId
            })
            .then(response => {
                if (!response.ok) throw new Error('Network error');
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    showToast(data.message, 'success');
                    
                    // Update UI to show "Booked" status
                    const footer = btnElement.parentElement;
                    footer.innerHTML = `
                        <span class="d-inline-flex align-items-center gap-2 px-3 py-2 label-sm data-mono" style="border: 2px solid var(--lime); color: var(--lime); background: var(--surface-container-high);">
                            <i class="bi bi-check-circle-fill"></i> BOOKED
                        </span>
                        <button class="btn-secondary px-3 py-1 text-error ms-2" style="border-color: var(--error);" onclick="cancelBooking(${data.bookingId}, ${sessionId}, this)">
                            <i class="bi bi-x-circle me-1"></i> Cancel
                        </button>
                    `;

                    // Increment capacity on UI
                    const card = footer.closest('.card-elevated');
                    if (card) {
                        const capacityElem = card.querySelector('.bi-people').parentElement.nextElementSibling;
                        if (capacityElem) {
                            let text = capacityElem.textContent;
                            let parts = text.split('/');
                            if (parts.length === 2) {
                                let booked = parseInt(parts[0]);
                                capacityElem.textContent = (booked + 1) + '/' + parts[1];
                            }
                        }
                    }
                } else {
                    btnElement.innerHTML = originalHtml;
                    btnElement.disabled = false;
                    showToast(data.message, 'error');
                }
            })
            .catch(error => {
                btnElement.innerHTML = originalHtml;
                btnElement.disabled = false;
                showToast('An error occurred. Please try again.', 'error');
            });
        }

        function cancelBooking(bookingId, sessionId, btnElement) {
            if (!confirm('Are you sure you want to cancel this booking?')) {
                return;
            }
            
            // Visual loading state
            const originalHtml = btnElement.innerHTML;
            btnElement.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Canceling...';
            btnElement.disabled = true;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            fetch('@Url.Action("Cancel", "Booking")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: 'bookingId=' + bookingId
            })
            .then(response => {
                if (!response.ok) throw new Error('Network error');
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    showToast(data.message, 'success');
                    
                    // Update UI back to "Book Now"
                    const footer = btnElement.parentElement;
                    footer.innerHTML = `
                        <button class="ke-btn ke-btn-primary w-100 py-2 d-flex justify-content-center align-items-center gap-2" onclick="bookSession(${sessionId}, this)">
                            <i class="bi bi-plus-circle"></i> Book Now
                        </button>
                    `;

                    // Decrement capacity on UI
                    const card = footer.closest('.card-elevated');
                    if (card) {
                        const capacityElem = card.querySelector('.bi-people').parentElement.nextElementSibling;
                        if (capacityElem) {
                            let text = capacityElem.textContent;
                            let parts = text.split('/');
                            if (parts.length === 2) {
                                let booked = parseInt(parts[0]);
                                capacityElem.textContent = Math.max(0, booked - 1) + '/' + parts[1];
                            }
                        }
                    }
                } else {
                    btnElement.innerHTML = originalHtml;
                    btnElement.disabled = false;
                    showToast(data.message, 'error');
                }
            })
            .catch(error => {
                btnElement.innerHTML = originalHtml;
                btnElement.disabled = false;
                showToast('An error occurred. Please try again.', 'error');
            });
        }

        function showToast(message, type) {
            const isSuccess = type === 'success';
            const alertDiv = document.createElement('div');
            alertDiv.className = 'mb-4 p-3 border-structural bg-surface d-flex align-items-center shadow-lg';
            alertDiv.style.borderLeftColor = isSuccess ? 'var(--primary)' : 'var(--error)';
            alertDiv.style.position = 'fixed';
            alertDiv.style.top = '20px';
            alertDiv.style.right = '20px';
            alertDiv.style.zIndex = '9999';
            alertDiv.style.minWidth = '300px';
            
            alertDiv.innerHTML = `
                <i class="bi ${isSuccess ? 'bi-check-circle-fill text-primary' : 'bi-exclamation-triangle-fill text-error'} fs-4 me-3"></i>
                <span class="body-md ${!isSuccess ? 'text-error' : ''}">${message}</span>
                <button type="button" class="btn-close ms-auto" onclick="dismissAlert(this)" aria-label="Close"></button>
            `;
            
            document.body.appendChild(alertDiv);
            
            setTimeout(() => {
                if (document.body.contains(alertDiv)) {
                    alertDiv.style.opacity = '0';
                    alertDiv.style.transition = 'opacity 0.5s ease';
                    setTimeout(() => alertDiv.remove(), 500);
                }
            }, 5000);
        }
    </script>
}
