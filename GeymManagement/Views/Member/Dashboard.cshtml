@model GymManagement.Domain.DTOs.Members.Responses.MemberDashboardResponse
@{
    ViewData["Title"] = "Member Dashboard";
    Layout = "~/Views/Shared/_MemberLayout.cshtml";
}

<div class="container py-5">
    <div class="mb-5">
        <h1 class="fw-bold mb-0 text-white" style="font-family: 'Oswald', sans-serif; letter-spacing: 1px;">WELCOME BACK</h1>
        <p class="text-muted mt-1 mb-0">Track your progress and manage your memberships.</p>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 h-100" style="background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.05) !important; border-radius: 12px;">
                <div class="card-body p-5">
                    <h5 class="fw-bold text-white mb-4" style="font-family: 'Oswald', sans-serif;">ACTIVE MEMBERSHIP</h5>
                    
                    @if (Model.ActiveMembership != null)
                    {
                        <div class="d-flex align-items-center justify-content-between p-4 rounded" style="background: linear-gradient(135deg, rgba(249, 115, 22, 0.1), rgba(239, 68, 68, 0.1)); border: 1px solid rgba(249, 115, 22, 0.2);">
                            <div>
                                <span class="badge bg-success bg-opacity-25 text-success px-3 py-2 rounded-pill mb-2">Active</span>
                                <h3 class="text-white fw-bold mb-1">@Model.ActiveMembership.PlanName</h3>
                                <p class="text-muted mb-0">Renews on @Model.ActiveMembership.EndDate</p>
                            </div>
                            <i class="bi bi-check-circle-fill text-success" style="font-size: 3rem; opacity: 0.8;"></i>
                        </div>
                    }
                    else
                    {
                        <div class="p-4 rounded text-center" style="background: rgba(0, 0, 0, 0.4); border: 1px solid rgba(255, 255, 255, 0.05);">
                            <p class="text-muted mb-3">You don't have an active membership.</p>
                            <a asp-controller="Member" asp-action="Memberships" class="btn btn-sm btn-outline-warning rounded-pill px-4" style="color: #f97316; border-color: rgba(249,115,22,0.5);">View Plans</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-lg border-0 h-100" style="background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.05) !important; border-radius: 12px;">
                <div class="card-body p-4 text-center d-flex flex-column justify-content-center">
                    <div class="mb-3">
                        <i class="bi bi-fire fs-1" style="color: #f97316;"></i>
                    </div>
                    <h2 class="fw-bold text-white mb-1" style="font-family: 'JetBrains Mono', monospace;">@Model.TotalBookings</h2>
                    <p class="text-muted mb-0 small text-uppercase fw-bold letter-spacing-1">Total Bookings</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-lg border-0" style="background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.05) !important; border-radius: 12px;">
        <div class="card-body p-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold text-white mb-0" style="font-family: 'Oswald', sans-serif;">MY BOOKINGS</h5>
                <a asp-controller="Member" asp-action="Bookings" class="btn btn-sm btn-outline-warning rounded-pill px-3" style="color: #f97316; border-color: rgba(249,115,22,0.5);">View All</a>
            </div>
            
            @if (Model.UpcomingBookings.Any())
            {
                <div class="row g-3">
                    @foreach (var booking in Model.UpcomingBookings)
                    {
                        <div class="col-md-6">
                            <div class="p-4 rounded d-flex align-items-center" style="background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.05);">
                                <div class="bg-dark text-white rounded text-center p-2 me-4" style="min-width: 60px;">
                                    <div class="fs-4 fw-bold">
                                        <i class="bi bi-calendar-check text-warning" style="font-size: 1.5rem;"></i>
                                    </div>
                                </div>
                                <div>
                                    <h6 class="text-white fw-bold mb-1">@booking.SessionName</h6>
                                    <p class="text-muted small mb-0"><i class="bi bi-clock me-1"></i> @booking.Date @booking.Time &bull; Trainer: @booking.TrainerName</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted text-center py-4">No upcoming bookings found.</p>
            }
        </div>
    </div>
</div>

