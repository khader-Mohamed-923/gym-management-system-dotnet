@model TrainerDetailsViewModel

@{
    ViewData["Title"] = $"{Model.Name} - Trainer Details";
}

<div class="container py-5">
    
    <div class="ke-header-content mb-5">
        <div class="ke-header-text">
            <h1 class="ke-title">TRAINER DETAILS</h1>
            <p class="ke-subtitle">View complete profile information for this trainer</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card card-elevated">
                <div class="card-body p-4 p-md-5">
                    
                    @{
                        var spec = Model.Specialization.ToLower();
                        var specColor = spec switch {
                            "cardio" => "var(--error)",
                            "balance" => "var(--ice, var(--ice))",
                            "boxing" => "var(--primary)",
                            "yoga" => "var(--lime, #84cc16)",
                            "crossfit" => "var(--warning, var(--gold))",
                            "fitness" => "var(--purple, #a855f7)",
                            _ => "var(--text-muted)"
                        };
                    }

                    <div class="d-flex flex-column align-items-center text-center mb-5 pb-4 border-bottom border-structural">
                        <div class="d-flex align-items-center justify-content-center border-structural bg-surface mb-3" style="width: 100px; height: 100px; font-size: 2.5rem; color: var(--primary);">
                            @(Model.Name.Length >= 2 ? Model.Name.Substring(0, 2).ToUpper() : Model.Name.ToUpper())
                        </div>
                        <h2 class="display-lg text-on-surface mb-3">@Model.Name</h2>
                        <span class="d-inline-block px-3 py-1 label-sm data-mono" style="border: 2px solid @specColor; color: @specColor; background: var(--surface-container-high);">
                            @Model.Specialization Trainer
                        </span>
                    </div>

                    <div class="row g-4 mb-5">
                        <div class="col-md-6">
                            <div class="ke-detail-block">
                                <div class="ke-detail-label d-flex align-items-center gap-2 mb-2"><i class="bi bi-envelope"></i> Email</div>
                                <div class="ke-detail-value data-mono">@Model.Email</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="ke-detail-block">
                                <div class="ke-detail-label d-flex align-items-center gap-2 mb-2"><i class="bi bi-telephone"></i> Phone</div>
                                <div class="ke-detail-value data-mono">@Model.Phone</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="ke-detail-block">
                                <div class="ke-detail-label d-flex align-items-center gap-2 mb-2"><i class="bi bi-calendar3"></i> Date of Birth</div>
                                <div class="ke-detail-value data-mono">@Model.DateOfBirth</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="ke-detail-block">
                                <div class="ke-detail-label d-flex align-items-center gap-2 mb-2"><i class="bi bi-award"></i> Specialization</div>
                                <div class="ke-detail-value data-mono">@Model.Specialization</div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="ke-detail-block">
                                <div class="ke-detail-label d-flex align-items-center gap-2 mb-2"><i class="bi bi-geo-alt"></i> Address</div>
                                <div class="ke-detail-value">@Model.Address</div>
                            </div>
                        </div>
                    </div>

                    <div class="pt-4 border-top border-structural text-center">
                        <a asp-controller="Trainers" asp-action="Index" class="btn-secondary w-100 py-2 d-inline-block text-decoration-none">
                            ← Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
