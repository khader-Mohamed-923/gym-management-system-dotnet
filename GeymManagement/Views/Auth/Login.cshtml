@model LoginRequest

@{
    ViewData["Title"] = "Login";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card card-elevated">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-box-arrow-in-right fs-1 text-primary"></i>
                        <h2 class="display-md mt-2">Welcome Back</h2>
                        <p class="body-md text-muted">Sign in to your account</p>
                    </div>

                    <form asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-error mb-3 small"></div>

                        <div class="mb-3">
                            <label asp-for="UserName" class="label-sm mb-1">Username</label>
                            <input asp-for="UserName" class="input-field" placeholder="Username" />
                            <span asp-validation-for="UserName" class="text-error small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="label-sm mb-1">Password</label>
                            <input asp-for="Password" type="password" class="input-field" placeholder="Password" />
                            <span asp-validation-for="Password" class="text-error small"></span>
                        </div>

                        <button type="submit" class="ke-btn ke-btn-primary w-100 mb-3">
                            SIGN IN
                        </button>

                        <div class="text-center">
                            <p class="body-md text-muted mb-0">Don't have an account? <a asp-controller="Auth" asp-action="Register" class="text-decoration-none text-primary">Register here</a></p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
