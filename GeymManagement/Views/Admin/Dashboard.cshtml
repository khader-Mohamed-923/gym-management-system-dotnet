@model GymManagement.Domain.DTOs.Admin.Responses.AdminDashboardResponse
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="fw-bold mb-0 text-white" style="font-family: 'Oswald', sans-serif; letter-spacing: 1px;">ADMIN DASHBOARD</h1>
            <p class="text-muted mt-1 mb-0">System overview and management statistics.</p>
        </div>
        <a asp-controller="Admin" asp-action="DownloadReport" class="btn fw-bold px-4 py-2" style="background: linear-gradient(135deg, #f97316, #ef4444); border: none; color: #ffffff; border-radius: 8px;">
            <i class="bi bi-file-earmark-bar-graph"></i> Generate Report
        </a>
    </div>

    
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card shadow-lg border-0 h-100" style="background: rgba(255,255,255,0.03); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.05) !important; border-radius: 12px;">
                <div class="card-body p-4 text-center">
                    <div class="mb-3"><i class="bi bi-people fs-1" style="color: #f97316;"></i></div>
                    <h3 class="fw-bold mb-1" style="font-family: 'JetBrains Mono', monospace; color: #ffffff;">@Model.TotalActiveMembers</h3>
                    <p class="mb-0 small text-uppercase fw-bold" style="color: #9ca3af;">Active Members</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-lg border-0 h-100" style="background: rgba(255,255,255,0.03); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.05) !important; border-radius: 12px;">
                <div class="card-body p-4 text-center">
                    <div class="mb-3"><i class="bi bi-person-badge fs-1" style="color: #ef4444;"></i></div>
                    <h3 class="fw-bold mb-1" style="font-family: 'JetBrains Mono', monospace; color: #ffffff;">@Model.TotalTrainers</h3>
                    <p class="mb-0 small text-uppercase fw-bold" style="color: #9ca3af;">Trainers</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-lg border-0 h-100" style="background: rgba(255,255,255,0.03); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.05) !important; border-radius: 12px;">
                <div class="card-body p-4 text-center">
                    <div class="mb-3"><i class="bi bi-calendar-event fs-1" style="color: #f97316;"></i></div>
                    <h3 class="fw-bold mb-1" style="font-family: 'JetBrains Mono', monospace; color: #ffffff;">@Model.WeeklySessions</h3>
                    <p class="mb-0 small text-uppercase fw-bold" style="color: #9ca3af;">Weekly Sessions</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-lg border-0 h-100" style="background: rgba(255,255,255,0.03); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.05) !important; border-radius: 12px;">
                <div class="card-body p-4 text-center">
                    <div class="mb-3"><i class="bi bi-currency-dollar fs-1" style="color: #ef4444;"></i></div>
                    <h3 class="fw-bold mb-1" style="font-family: 'JetBrains Mono', monospace; color: #ffffff;">$@Model.MonthlyRevenue.ToString("N0")</h3>
                    <p class="mb-0 small text-uppercase fw-bold" style="color: #9ca3af;">Monthly Revenue</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 h-100" style="background: rgba(255,255,255,0.03); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.05) !important; border-radius: 12px;">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4" style="font-family: 'Oswald', sans-serif; color: #ffffff;">RECENT REGISTRATIONS</h5>
                    <div class="table-responsive">
                        <table class="table table-dark table-hover table-borderless align-middle" style="background: transparent;">
                            <thead>
                                <tr style="border-bottom: 1px solid rgba(255,255,255,0.1);">
                                    <th class="small text-uppercase pb-3" style="color: #9ca3af;">Name</th>
                                    <th class="small text-uppercase pb-3" style="color: #9ca3af;">Plan</th>
                                    <th class="small text-uppercase pb-3" style="color: #9ca3af;">Date</th>
                                    <th class="small text-uppercase pb-3" style="color: #9ca3af;">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.RecentRegistrations.Any())
                                {
                                    @foreach (var reg in Model.RecentRegistrations)
                                    {
                                        <tr>
                                            <td class="py-3">
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-dark rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; border: 1px solid rgba(255,255,255,0.1);">
                                                        <i class="bi bi-person text-white"></i>
                                                    </div>
                                                    <div>
                                                        <div class="fw-bold" style="color: #ffffff;">@reg.Name</div>
                                                        <div class="small" style="color: #9ca3af;">@reg.Email</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="py-3" style="color: #ffffff;">@reg.PlanName</td>
                                            <td class="py-3" style="color: #9ca3af;">@reg.Date</td>
                                            <td class="py-3">
                                                @if (reg.Status == "Active")
                                                {
                                                    <span class="badge bg-success bg-opacity-25 text-success px-3 py-2 rounded-pill">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary bg-opacity-25 text-secondary px-3 py-2 rounded-pill">Inactive</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4" style="color: #e5e7eb;">No members registered yet.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-lg border-0 h-100" style="background: rgba(255,255,255,0.03); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.05) !important; border-radius: 12px;">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4" style="font-family: 'Oswald', sans-serif; color: #ffffff;">QUICK ACTIONS</h5>
                    <div class="d-grid gap-3">
                        <a asp-controller="Members" asp-action="Create" class="btn btn-dark text-start p-3 d-flex align-items-center" style="border: 1px solid rgba(255,255,255,0.1); background: rgba(0,0,0,0.5);">
                            <div class="me-3" style="color: #f97316;"><i class="bi bi-person-plus fs-4"></i></div>
                            <div>
                                <div class="fw-bold" style="color: #ffffff;">Add New Member</div>
                                <div class="small" style="color: #9ca3af;">Manually register a user</div>
                            </div>
                        </a>
                        <a asp-controller="Sessions" asp-action="Create" class="btn btn-dark text-start p-3 d-flex align-items-center" style="border: 1px solid rgba(255,255,255,0.1); background: rgba(0,0,0,0.5);">
                            <div class="me-3" style="color: #ef4444;"><i class="bi bi-calendar-plus fs-4"></i></div>
                            <div>
                                <div class="fw-bold" style="color: #ffffff;">Create Session</div>
                                <div class="small" style="color: #9ca3af;">Schedule a new class</div>
                            </div>
                        </a>
                        <a asp-controller="Plans" asp-action="Index" class="btn btn-dark text-start p-3 d-flex align-items-center" style="border: 1px solid rgba(255,255,255,0.1); background: rgba(0,0,0,0.5);">
                            <div class="me-3" style="color: #f97316;"><i class="bi bi-credit-card fs-4"></i></div>
                            <div>
                                <div class="fw-bold" style="color: #ffffff;">Manage Plans</div>
                                <div class="small" style="color: #9ca3af;">Update pricing &amp; features</div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
