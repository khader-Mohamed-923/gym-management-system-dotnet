@model MembershipCreateViewModel

@{
    ViewData["Title"] = "New Membership";
}

<div class="container py-5">
    <div class="ke-header-content mb-5">
        <div class="ke-header-text">
            <h1 class="ke-title">ASSIGN MEMBERSHIP</h1>
            <p class="ke-subtitle">Assign a training plan to a gym member</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card card-elevated">
                <div class="card-body p-4 p-md-5">
                    <form method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-error small mb-4"></div>

                        <h3 class="ke-section-header text-primary pb-2 border-bottom border-structural mb-4">
                            MEMBERSHIP DETAILS
                        </h3>

                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label asp-for="MemberId" class="label-sm mb-1">Member <span class="text-error">*</span></label>
                                <select asp-for="MemberId" class="input-field">
                                    <option value="" style="background: var(--surface); color: var(--on-surface);">Select Member</option>
                                    @if (ViewBag.Members != null)
                                    {
                                        foreach (var member in ViewBag.Members)
                                        {
                                            <option value="@member.Id" style="background: var(--surface); color: var(--on-surface);">@member.Name</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="MemberId" class="text-error small mt-1"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PlanId" class="label-sm mb-1">Plan <span class="text-error">*</span></label>
                                <select asp-for="PlanId" class="input-field">
                                    <option value="" style="background: var(--surface); color: var(--on-surface);">Select Active Plan</option>
                                    @if (ViewBag.Plans != null)
                                    {
                                        foreach (var plan in ViewBag.Plans)
                                        {
                                            <option value="@plan.Id" style="background: var(--surface); color: var(--on-surface);">@plan.Name</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="PlanId" class="text-error small mt-1"></span>
                            </div>
                        </div>

                        <div class="mb-5">
                            <label asp-for="StartDate" class="label-sm mb-1">Start Date <span class="text-error">*</span></label>
                            <input asp-for="StartDate" type="date" class="input-field" />
                            <span asp-validation-for="StartDate" class="text-error small mt-1"></span>
                            <div class="body-sm text-muted mt-2">
                                End date will be calculated automatically based on the selected plan's duration.
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-3 pt-4 border-top border-structural">
                            <a asp-controller="Memberships" asp-action="Index" class="btn-secondary px-4 py-2 text-decoration-none">
                                Cancel
                            </a>
                            <button type="submit" class="ke-btn ke-btn-primary px-4 py-2">
                                <span class="fw-bold me-2">+</span> Assign Membership
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
