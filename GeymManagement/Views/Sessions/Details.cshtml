@model SessionDetailsViewModel

@{
    ViewData["Title"] = "Session Details";
}

<div class="container py-5">
    <div class="ke-header-content mb-5">
        <div class="ke-header-text">
            <h1 class="ke-title">SESSION DETAILS</h1>
            <p class="ke-subtitle">View session information</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card card-elevated">
                <div class="card-body p-4 p-md-5">
                    @{
                        var statusColor = Model.Status.ToString().ToLower() switch {
                            "upcoming" => "var(--ice, #38bdf8)",
                            "ongoing" => "var(--lime, #84cc16)",
                            _ => "var(--text-muted)"
                        };
                    }

                    <div class="pb-4 mb-5 border-bottom border-structural">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="d-inline-block px-3 py-1 label-sm data-mono" style="border: 2px solid var(--primary); color: var(--primary); background: var(--surface-container-high);">
                                @Model.CategoryName
                            </span>
                            <span class="d-inline-flex align-items-center gap-2 label-sm data-mono" style="color: @statusColor;">
                                <span style="width: 8px; height: 8px; background: currentColor; border-radius: 50%;"></span>
                                @Model.Status
                            </span>
                        </div>
                        <h2 class="display-md text-primary m-0">@Model.Description</h2>
                    </div>

                    <h3 class="ke-section-header text-primary pb-2 border-bottom border-structural mb-4">
                        SCHEDULE INFORMATION
                    </h3>

                    <div class="row g-4 mb-5">
                        <div class="col-md-4 col-sm-6">
                            <div class="ke-detail-block h-100">
                                <div class="ke-detail-label d-flex align-items-center gap-2 mb-2"><i class="bi bi-calendar-event"></i> Start Date</div>
                                <div class="ke-detail-value data-mono">@Model.StartDate.ToString("MMM dd, yyyy")</div>
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-6">
                            <div class="ke-detail-block h-100">
                                <div class="ke-detail-label d-flex align-items-center gap-2 mb-2"><i class="bi bi-clock"></i> Start Time</div>
                                <div class="ke-detail-value data-mono">@Model.StartDate.ToString("HH:mm")</div>
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-6">
                            <div class="ke-detail-block h-100">
                                <div class="ke-detail-label d-flex align-items-center gap-2 mb-2"><i class="bi bi-hourglass-split"></i> Duration</div>
                                <div class="ke-detail-value data-mono">@((int)(Model.EndDate - Model.StartDate).TotalMinutes) min</div>
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-6">
                            <div class="ke-detail-block h-100">
                                <div class="ke-detail-label d-flex align-items-center gap-2 mb-2"><i class="bi bi-calendar-check"></i> End Date</div>
                                <div class="ke-detail-value data-mono">@Model.EndDate.ToString("MMM dd, yyyy")</div>
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-6">
                            <div class="ke-detail-block h-100">
                                <div class="ke-detail-label d-flex align-items-center gap-2 mb-2"><i class="bi bi-clock-history"></i> End Time</div>
                                <div class="ke-detail-value data-mono">@Model.EndDate.ToString("HH:mm")</div>
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-6">
                            <div class="ke-detail-block h-100">
                                <div class="ke-detail-label d-flex align-items-center gap-2 mb-2"><i class="bi bi-people"></i> Capacity</div>
                                <div class="ke-detail-value data-mono">@Model.BookedCount / @Model.Capacity slots</div>
                            </div>
                        </div>
                    </div>

                    <h3 class="ke-section-header text-primary pb-2 border-bottom border-structural mb-4">
                        TRAINER INFORMATION
                    </h3>

                    <div class="row g-4 mb-5">
                        <div class="col-md-6">
                            <div class="ke-detail-block h-100">
                                <div class="ke-detail-label d-flex align-items-center gap-2 mb-2"><i class="bi bi-person-badge"></i> Trainer Name</div>
                                <div class="ke-detail-value text-on-surface fw-bold">@Model.TrainerName</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="ke-detail-block h-100">
                                <div class="ke-detail-label d-flex align-items-center gap-2 mb-2"><i class="bi bi-star"></i> Specialization</div>
                                <div class="ke-detail-value data-mono">@Model.TrainerSpecialization</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="ke-detail-block h-100">
                                <div class="ke-detail-label d-flex align-items-center gap-2 mb-2"><i class="bi bi-envelope"></i> Email</div>
                                <div class="ke-detail-value data-mono">@Model.TrainerEmail</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="ke-detail-block h-100">
                                <div class="ke-detail-label d-flex align-items-center gap-2 mb-2"><i class="bi bi-telephone"></i> Phone</div>
                                <div class="ke-detail-value data-mono">@Model.TrainerPhone</div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-3 pt-4 border-top border-structural">
                        <a asp-controller="Sessions" asp-action="Index" class="btn-secondary px-4 py-2 text-decoration-none">
                            ← Back to Sessions
                        </a>
                        <div class="ms-auto d-flex gap-3">
                            <a asp-controller="Sessions" asp-action="Edit" asp-route-id="@Model.Id" class="ke-btn ke-btn-primary px-4 py-2 text-decoration-none">
                                Edit Session
                            </a>
                            <a asp-controller="Sessions" asp-action="Delete" asp-route-id="@Model.Id" class="btn-secondary px-4 py-2 text-error text-decoration-none" style="border-color: var(--error);">
                                Delete Session
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
