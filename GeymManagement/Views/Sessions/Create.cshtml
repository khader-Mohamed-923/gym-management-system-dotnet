@model SessionCreateViewModel

@{
    ViewData["Title"] = "Create Session";
}

<div class="container py-5">
    <div class="ke-header-content mb-5">
        <div class="ke-header-text">
            <h1 class="ke-title">CREATE SESSION</h1>
            <p class="ke-subtitle">Schedule a new training session</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card card-elevated">
                <div class="card-body p-4 p-md-5">
                    <form method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-error small mb-4"></div>

                        <h3 class="ke-section-header text-primary pb-2 border-bottom border-structural mb-4">
                            SESSION INFORMATION
                        </h3>

                        <div class="row g-4 mb-5">
                            <div class="col-md-8">
                                <label asp-for="Description" class="label-sm mb-1">Description <span class="text-error">*</span></label>
                                <input asp-for="Description" type="text" class="input-field" placeholder="Enter session description" />
                                <span asp-validation-for="Description" class="text-error small mt-1"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Capacity" class="label-sm mb-1">Capacity <span class="text-error">*</span></label>
                                <input asp-for="Capacity" type="number" class="input-field" placeholder="Max capacity" />
                                <span asp-validation-for="Capacity" class="text-error small mt-1"></span>
                            </div>
                        </div>

                        <h3 class="ke-section-header text-primary pb-2 border-bottom border-structural mb-4">
                            SCHEDULE
                        </h3>

                        <div class="row g-4 mb-5">
                            <div class="col-md-6">
                                <label asp-for="StartDate" class="label-sm mb-1">Start Date & Time <span class="text-error">*</span></label>
                                <input asp-for="StartDate" type="datetime-local" class="input-field" />
                                <span asp-validation-for="StartDate" class="text-error small mt-1"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EndDate" class="label-sm mb-1">End Date & Time <span class="text-error">*</span></label>
                                <input asp-for="EndDate" type="datetime-local" class="input-field" />
                                <span asp-validation-for="EndDate" class="text-error small mt-1"></span>
                            </div>
                        </div>

                        <h3 class="ke-section-header text-primary pb-2 border-bottom border-structural mb-4">
                            ASSIGNMENT
                        </h3>

                        <div class="row g-4 mb-5">
                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="label-sm mb-1">Category <span class="text-error">*</span></label>
                                <select asp-for="CategoryId" class="input-field">
                                    <option value="" style="background: var(--surface); color: var(--on-surface);">Select Category</option>
                                    @if (ViewBag.Categories != null)
                                    {
                                        foreach (var category in ViewBag.Categories)
                                        {
                                            <option value="@category.Id" style="background: var(--surface); color: var(--on-surface);">@category.Name</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="CategoryId" class="text-error small mt-1"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="TrainerId" class="label-sm mb-1">Trainer <span class="text-error">*</span></label>
                                <select asp-for="TrainerId" class="input-field">
                                    <option value="" style="background: var(--surface); color: var(--on-surface);">Select Trainer</option>
                                    @if (ViewBag.Trainers != null)
                                    {
                                        foreach (var trainer in ViewBag.Trainers)
                                        {
                                            <option value="@trainer.Id" style="background: var(--surface); color: var(--on-surface);">@trainer.Name</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="TrainerId" class="text-error small mt-1"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-3 pt-4 border-top border-structural">
                            <a asp-controller="Sessions" asp-action="Index" class="btn-secondary px-4 py-2 text-decoration-none">
                                Cancel
                            </a>
                            <button type="submit" class="ke-btn ke-btn-primary px-4 py-2">
                                <span class="fw-bold me-2">+</span> Create Session
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
