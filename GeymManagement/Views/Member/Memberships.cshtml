@model IEnumerable<MemberMembershipResponse>
@{
    ViewData["Title"] = "My Memberships";
    Layout = "~/Views/Shared/_MemberLayout.cshtml";
}

<div class="container py-5">
    <div class="ke-header-content mb-5">
        <div class="ke-header-text">
            <h1 class="ke-title">MY MEMBERSHIPS</h1>
            <p class="ke-subtitle">Manage your active plans and view membership history.</p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card card-elevated p-5 text-center bg-surface">
            <i class="bi bi-card-heading text-muted" style="font-size: 4rem;"></i>
            <h4 class="display-md mt-3 mb-2">No memberships found</h4>
            <p class="body-md text-muted mb-4">You do not have any active or past memberships.</p>
            <a href="#" class="ke-btn ke-btn-primary px-4 py-2 d-inline-block mx-auto" style="width: fit-content;">Explore Plans</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var membership in Model)
            {
                var isActive = membership.IsActive;
                var borderColor = isActive ? "var(--primary)" : "var(--border-color)";
                var statusColor = isActive ? "var(--primary)" : "var(--text-muted)";
                var opacityStyle = isActive ? "" : "opacity: 0.7;";

                <div class="col-md-6 col-lg-4">
                    <div class="card card-elevated h-100 position-relative" style="border-top-color: @borderColor; @opacityStyle">
                        
                        <div class="position-absolute top-0 end-0 p-3">
                            <span class="d-inline-block px-3 py-1 label-sm data-mono" style="border: 2px solid @statusColor; color: @statusColor; background: var(--surface-container-high);">
                                @if(isActive) { <i class="bi bi-check-square-fill me-1"></i> } @(isActive ? "Active" : "Expired")
                            </span>
                        </div>

                        <div class="card-body p-4 p-md-5 d-flex flex-column mt-3">
                            <div class="mb-4">
                                <h3 class="headline-md mb-2 text-primary">@membership.PlanName</h3>
                                <div class="d-flex align-items-baseline">
                                    <h2 class="display-md mb-0 text-on-surface data-mono">$@membership.Price</h2>
                                </div>
                            </div>

                            <div class="mt-auto">
                                <hr class="border-structural mb-4" />
                                <div class="d-flex justify-content-between mb-3">
                                    <span class="label-sm text-muted">Start Date</span>
                                    <span class="body-md data-mono">@membership.StartDate</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="label-sm text-muted">End Date</span>
                                    <span class="body-md data-mono">@membership.EndDate</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
