@model IEnumerable<MembershipIndexViewModel>

@{
    ViewData["Title"] = "Memberships";
}

<div class="container py-5">
    <div class="ke-header-content mb-5 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="ke-header-text">
            <h1 class="ke-title">MEMBERSHIPS</h1>
            <p class="ke-subtitle">Manage member subscriptions and active plans</p>
        </div>
        <a asp-controller="Memberships" asp-action="Create" class="ke-btn ke-btn-primary px-4 py-2">
            <span class="fs-5 fw-bold me-2">+</span> New Membership
        </a>
    </div>

    @if (TempData[TempDataKeys.SuccessMessage] != null)
    {
        <div class="mb-4 p-3 border-structural bg-surface d-flex align-items-center" style="border-left-color: var(--primary);">
            <i class="bi bi-check-circle-fill text-primary fs-4 me-3"></i>
            <span class="body-md">@TempData[TempDataKeys.SuccessMessage]</span>
        </div>
    }
    else if (TempData[TempDataKeys.ErrorMessage] != null)
    {
        <div class="mb-4 p-3 border-structural bg-surface d-flex align-items-center" style="border-left-color: var(--error);">
            <i class="bi bi-exclamation-triangle-fill text-error fs-4 me-3"></i>
            <span class="body-md text-error">@TempData[TempDataKeys.ErrorMessage]</span>
        </div>
    }

    @if (Model.Any())
    {
        <div class="card card-elevated" style="padding: 0; overflow: hidden;">
            <div class="table-responsive">
                <table class="table table-hover mb-0" style="--bs-table-bg: var(--surface); --bs-table-color: var(--on-surface);">
                    <thead style="border-bottom: 2px solid var(--border-color);">
                        <tr>
                            <th class="label-sm text-muted">Member Name</th>
                            <th class="label-sm text-muted">Plan Name</th>
                            <th class="label-sm text-muted">Start Date</th>
                            <th class="label-sm text-muted">End Date</th>
                            <th class="label-sm text-muted">Status</th>
                            <th class="label-sm text-muted text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var membership in Model)
                        {
                            <tr style="border-bottom: 1px solid var(--border-color);">
                                <td class="align-middle">
                                    <div class="body-md text-on-surface fw-bold">@membership.MemberName</div>
                                </td>
                                <td class="align-middle">
                                    <span class="d-inline-block px-3 py-1 label-sm data-mono" style="border: 2px solid var(--primary); color: var(--primary); background: var(--surface-container-high);">
                                        @membership.PlanName
                                    </span>
                                </td>
                                <td class="align-middle">
                                    <span class="body-sm data-mono text-muted">@membership.StartDate.ToString("MMM dd, yyyy")</span>
                                </td>
                                <td class="align-middle">
                                    <span class="body-sm data-mono text-muted">@membership.EndDate.ToString("MMM dd, yyyy")</span>
                                </td>
                                <td class="align-middle">
                                    @if (membership.Status == MembershipStatus.Active)
                                    {
                                        <span class="d-inline-flex align-items-center gap-2 label-sm data-mono" style="color: var(--lime);">
                                            <span style="width: 6px; height: 6px; border-radius: 50%; background: currentColor;"></span> Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="d-inline-flex align-items-center gap-2 label-sm data-mono" style="color: var(--text-muted);">
                                            <span style="width: 6px; height: 6px; border-radius: 50%; background: currentColor;"></span> Expired
                                        </span>
                                    }
                                </td>
                                <td class="align-middle text-end">
                                    <form asp-action="Cancel" asp-route-id="@membership.Id" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to cancel this membership?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-secondary px-3 py-1 text-error" style="border-color: var(--error);">
                                            Cancel
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card card-elevated p-5 text-center">
            <div class="display-lg mb-3">🎟️</div>
            <h2 class="display-md mb-2">No Memberships Found</h2>
            <p class="body-md text-muted mb-4">Assign a membership plan to a member to get started</p>
            <a asp-action="Create" class="ke-btn ke-btn-primary px-4 py-2 d-inline-block mx-auto" style="width: fit-content;">
                <span class="fs-5 fw-bold me-2">+</span> Assign First Membership
            </a>
        </div>
    }
</div>

@section Scripts {
    <partial name="_AlertDismissScript" />
}

