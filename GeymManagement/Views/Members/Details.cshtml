@model MemberDetailsViewModel

@{
    ViewData["Title"] = $"{Model.Name} - Member Details";
}

<div class="container py-5">
    
    <div class="ke-header-content mb-5">
        <div class="ke-header-text">
            <h1 class="ke-title">MEMBER DETAILS</h1>
            <p class="ke-subtitle">View complete information about this member</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card card-elevated text-center mb-4">
                <div class="d-flex align-items-center justify-content-center border-structural bg-surface mx-auto mb-3" style="width: 100px; height: 100px; font-size: 2rem;">
                    <span class="data-mono">@(Model.Name.Length >= 2 ? Model.Name.Substring(0, 2).ToUpper() : Model.Name.ToUpper())</span>
                </div>
                <h2 class="display-md mb-3">@Model.Name</h2>
                @if (!string.IsNullOrEmpty(Model.PlanName))
                {
                    <span class="plan-chip">@Model.PlanName</span>
                }
                else
                {
                    <span class="plan-chip" style="background: var(--surface); color: var(--on-surface);">No Plan</span>
                }
            </div>

            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <div class="ke-detail-block">
                        <div class="ke-detail-label">📧 Email</div>
                        <div class="ke-detail-value data-mono">@Model.Email</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="ke-detail-block">
                        <div class="ke-detail-label">📞 Phone</div>
                        <div class="ke-detail-value data-mono">@Model.Phone</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="ke-detail-block">
                        <div class="ke-detail-label">👤 Gender</div>
                        <div class="ke-detail-value data-mono">@Model.Gender</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="ke-detail-block">
                        <div class="ke-detail-label">📅 Date of Birth</div>
                        <div class="ke-detail-value data-mono">@Model.DateOfBirth</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="ke-detail-block" style="border-left-color: var(--primary);">
                        <div class="ke-detail-label">🏃 Membership Start</div>
                        <div class="ke-detail-value data-mono text-primary">@Model.MembershipStartDate</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="ke-detail-block" style="border-left-color: var(--error);">
                        <div class="ke-detail-label">⏱️ Membership End</div>
                        <div class="ke-detail-value data-mono text-error">@Model.MembershipEndDate</div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="ke-detail-block">
                        <div class="ke-detail-label">📍 Address</div>
                        <div class="ke-detail-value data-mono">@Model.Address</div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <a asp-controller="Members" asp-action="Index" class="btn-secondary">
                    ← Back to List
                </a>
                <a asp-controller="Members" asp-action="Edit" asp-route-id="@ViewContext.RouteData.Values["id"]" class="ke-btn ke-btn-primary">
                    Edit Member
                </a>
            </div>
        </div>
    </div>
</div>
