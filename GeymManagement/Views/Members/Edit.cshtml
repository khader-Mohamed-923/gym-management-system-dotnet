@model MemberEditViewModel

@{
    ViewData["Title"] = "Edit Member";
}

<div class="container py-5">
    
    <div class="ke-header-content mb-5">
        <div class="ke-header-text">
            <h1 class="ke-title">EDIT MEMBER</h1>
            <p class="ke-subtitle">Update member information</p>
        </div>
    </div>

    @if (TempData[TempDataKeys.SuccessMessage] != null)
    {
        <div class="mb-4 p-3" style="border: 2px solid var(--primary); background: var(--surface-container-low);">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="me-2 text-primary">✓</span>
                    <span class="text-on-surface">@TempData[TempDataKeys.SuccessMessage]</span>
                </div>
                <button type="button" class="btn-close btn-close" onclick="this.parentElement.parentElement.remove();"></button>
            </div>
        </div>
    }
    else if (TempData[TempDataKeys.ErrorMessage] != null)
    {
        <div class="mb-4 p-3" style="border: 2px solid var(--error); background: var(--surface-container-low);">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="me-2 text-error">⚠️</span>
                    <span class="text-on-surface">@TempData[TempDataKeys.ErrorMessage]</span>
                </div>
                <button type="button" class="btn-close btn-close" onclick="this.parentElement.parentElement.remove();"></button>
            </div>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card card-elevated">
                <form asp-controller="Members" asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Name" />
                    <input type="hidden" asp-for="Photo" />

                    <div class="card-body p-4 p-md-5">
                        
                        <div class="text-center mb-5">
                            <div class="d-flex align-items-center justify-content-center border-structural bg-surface mx-auto mb-3" style="width: 80px; height: 80px; font-size: 1.5rem;">
                                @{
                                    var memberName = Model.Name ?? "";
                                    var initials = memberName.Length >= 2 ? memberName.Substring(0, 2).ToUpper() : memberName.ToUpper();
                                }
                                <span class="data-mono">@initials</span>
                            </div>
                            <h2 class="display-md mb-0">@Model.Name</h2>
                        </div>

                        <hr class="border-structural my-5" />

                        <h3 class="ke-section-header mb-4 text-primary">EDITABLE INFORMATION</h3>

                        <div class="row g-4 mb-4">
                            <div class="col-12">
                                <label asp-for="Email" class="label-sm mb-1">📧 Email *</label>
                                <input asp-for="Email" class="input-field" placeholder="Enter email address" />
                                <span asp-validation-for="Email" class="text-error small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="label-sm mb-1">📞 Phone *</label>
                                <input asp-for="Phone" class="input-field" placeholder="Enter phone number" />
                                <span asp-validation-for="Phone" class="text-error small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="BuildingNumber" class="label-sm mb-1">🏠 Building Number</label>
                                <input asp-for="BuildingNumber" class="input-field" placeholder="Enter building number" />
                                <span asp-validation-for="BuildingNumber" class="text-error small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="City" class="label-sm mb-1">🏙️ City</label>
                                <input asp-for="City" class="input-field" placeholder="Enter city" />
                                <span asp-validation-for="City" class="text-error small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Street" class="label-sm mb-1">🛣️ Street</label>
                                <input asp-for="Street" class="input-field" placeholder="Enter street name" />
                                <span asp-validation-for="Street" class="text-error small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-5">
                            <a asp-controller="Members" asp-action="Index" class="btn-secondary">
                                Cancel
                            </a>
                            <button type="submit" class="ke-btn ke-btn-primary">
                                Save Changes
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_AlertDismissScript" />
}
