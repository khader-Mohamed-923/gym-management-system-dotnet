@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-5">
    
    <div class="ke-header-content text-center mb-5" style="padding: var(--space-2xl) 0;">
        <h1 class="display-md text-primary mb-3">
            GOOD MORNING, ADMIN
        </h1>
        <p class="body-lg text-muted">
            Today is going to be a strong day. Your gym is performing well.
        </p>
    </div>

    
    <div class="row g-4 mb-5">
        
        <div class="col-md-6 col-xl-3">
            <div class="card card-elevated text-center h-100" style="border-top-color: var(--lime);">
                <div class="card-body p-4">
                    <p class="label-sm mb-3" style="color: var(--lime);">Active Members</p>
                    <p class="display-md text-on-surface mb-2">85</p>
                    <p class="body-sm mb-0" style="color: var(--lime);">↑ 12 joined this week</p>
                </div>
            </div>
        </div>

        
        <div class="col-md-6 col-xl-3">
            <div class="card card-elevated text-center h-100" style="border-top-color: var(--primary);">
                <div class="card-body p-4">
                    <p class="label-sm text-primary mb-3">Today's Check-ins</p>
                    <p class="display-md text-on-surface mb-2">67</p>
                    <p class="body-sm text-muted mb-0">Peak: 9–11 AM</p>
                </div>
            </div>
        </div>

        
        <div class="col-md-6 col-xl-3">
            <div class="card card-elevated text-center h-100" style="border-top-color: var(--error);">
                <div class="card-body p-4">
                    <p class="label-sm text-error mb-3">Expiring This Week</p>
                    <p class="display-md text-on-surface mb-2">14</p>
                    <p class="body-sm text-muted mb-0">Renewal reminders sent</p>
                </div>
            </div>
        </div>

        
        <div class="col-md-6 col-xl-3">
            <div class="card card-elevated text-center h-100" style="border-top-color: var(--gold);">
                <div class="card-body p-4">
                    <p class="label-sm mb-3" style="color: var(--gold);">Revenue (MTD)</p>
                    <p class="display-md text-on-surface mb-2">24.5K</p>
                    <p class="body-sm text-muted mb-0">EGP</p>
                </div>
            </div>
        </div>
    </div>

    
    <div class="card card-elevated mb-5">
        <div class="card-body p-4">
            <div class="row g-4 text-center">
                <div class="col-6 col-md-4 col-lg-2">
                    <p class="display-md text-primary mb-1">100</p>
                    <p class="label-sm text-muted">Total Members</p>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <p class="display-md mb-1" style="color: var(--lime);">85</p>
                    <p class="label-sm text-muted">Active</p>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <p class="display-md mb-1" style="color: var(--ice);">20</p>
                    <p class="label-sm text-muted">Trainers</p>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <p class="display-md mb-1" style="color: var(--gold);">3</p>
                    <p class="label-sm text-muted">Upcoming Sessions</p>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <p class="display-md text-primary mb-1">5</p>
                    <p class="label-sm text-muted">Ongoing Sessions</p>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <p class="display-md mb-1" style="color: var(--lime);">20</p>
                    <p class="label-sm text-muted">Completed</p>
                </div>
            </div>
        </div>
    </div>

    
    <div class="row g-4 mb-5">
        
        <div class="col-md-4">
            <div class="card card-elevated h-100 p-4">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="d-flex align-items-center justify-content-center bg-background border-structural" style="width: 50px; height: 50px; flex-shrink: 0;">
                        <i class="bi bi-people text-primary fs-4"></i>
                    </div>
                    <div>
                        <h3 class="display-sm text-on-surface m-0">Members</h3>
                        <p class="body-sm text-muted m-0">Manage gym members</p>
                    </div>
                </div>
                <a asp-controller="Members" asp-action="Index" class="ke-btn ke-btn-primary w-100 text-center text-decoration-none mt-auto">
                    View All Members
                </a>
            </div>
        </div>

        
        <div class="col-md-4">
            <div class="card card-elevated h-100 p-4">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="d-flex align-items-center justify-content-center bg-background border-structural" style="width: 50px; height: 50px; flex-shrink: 0; border-color: var(--lime);">
                        <i class="bi bi-credit-card fs-4" style="color: var(--lime);"></i>
                    </div>
                    <div>
                        <h3 class="display-sm text-on-surface m-0">Plans</h3>
                        <p class="body-sm text-muted m-0">Membership packages</p>
                    </div>
                </div>
                <a asp-controller="Plans" asp-action="Index" class="ke-btn ke-btn-success w-100 text-center text-decoration-none mt-auto">
                    View All Plans
                </a>
            </div>
        </div>

        
        <div class="col-md-4">
            <div class="card card-elevated h-100 p-4">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="d-flex align-items-center justify-content-center bg-background border-structural" style="width: 50px; height: 50px; flex-shrink: 0; border-color: var(--ice);">
                        <i class="bi bi-calendar-event fs-4" style="color: var(--ice);"></i>
                    </div>
                    <div>
                        <h3 class="display-sm text-on-surface m-0">Sessions</h3>
                        <p class="body-sm text-muted m-0">Training schedule</p>
                    </div>
                </div>
                <a asp-controller="Booking" asp-action="Schedule" class="btn-secondary w-100 text-center text-decoration-none mt-auto">
                    View Schedule
                </a>
            </div>
        </div>
    </div>

    
    <div class="card card-elevated text-center p-5 border-structural" style="border-top: 4px solid var(--primary);">
        <h2 class="display-md text-primary mb-3">
            YOUR BODY CAN STAND ALMOST ANYTHING
        </h2>
        <p class="body-md text-muted mx-auto mb-4" style="max-width: 600px;">
            It's your mind that needs convincing. Push past your limits, stay committed, and watch as your body transforms into a powerhouse of strength and resilience.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <button class="ke-btn ke-btn-primary px-4 py-2">Get Started</button>
            <button class="btn-secondary px-4 py-2">Explore More</button>
        </div>
    </div>
</div>
