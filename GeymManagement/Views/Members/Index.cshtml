@model IEnumerable<MemberIndexViewModel>
@{
    ViewData["Title"] = "Members";
}

<div class="container py-5">
    
    <div class="ke-header-content mb-5">
        <div class="ke-header-text">
            <h1 class="ke-title">MEMBERS</h1>
            <p class="ke-subtitle">Manage your gym members and their memberships</p>
        </div>
        <a asp-controller="Members" asp-action="Create" class="ke-btn ke-btn-primary">
            <span style="font-size: 1.25rem; font-weight: 700;" class="me-2">+</span>
            Add Member
        </a>
    </div>

    @if (TempData[TempDataKeys.SuccessMessage] != null)
    {
        <div class="mb-4 p-3" style="border: 2px solid var(--primary); background: var(--surface-container-low);">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="me-2 text-primary">✓</span>
                    <span class="text-on-surface">@TempData[TempDataKeys.SuccessMessage]</span>
                </div>
                <button type="button" class="btn-close btn-close-white" onclick="this.parentElement.parentElement.remove();"></button>
            </div>
        </div>
    }
    else if (TempData[TempDataKeys.ErrorMessage] != null)
    {
        <div class="mb-4 p-3" style="border: 2px solid var(--error); background: var(--surface-container-low);">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="me-2 text-error">⚠️</span>
                    <span class="text-on-surface">@TempData[TempDataKeys.ErrorMessage]</span>
                </div>
                <button type="button" class="btn-close btn-close-white" onclick="this.parentElement.parentElement.remove();"></button>
            </div>
        </div>
    }

    @if (Model.Any())
    {
        <div class="card card-elevated roster-container">
            <table class="roster-list">
                <thead>
                    <tr>
                        <th class="roster-header">Photo</th>
                        <th class="roster-header">Name</th>
                        <th class="roster-header">Email</th>
                        <th class="roster-header">Gender</th>
                        <th class="roster-header">Phone</th>
                        <th class="roster-header">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in Model)
                    {
                        <tr class="roster-row">
                            <td class="roster-cell">
                                <div class="d-flex align-items-center justify-content-center border-structural bg-surface" style="width: 40px; height: 40px;">
                                    @if (string.IsNullOrWhiteSpace(member.PhotoPath))
                                    {
                                        <span class="data-mono">@(member.Name.Length >= 2 ? member.Name.Substring(0, 2).ToUpper() : member.Name.ToUpper())</span>
                                    }
                                    else
                                    {
                                        <img src="@member.PhotoPath" alt="@member.Name" style="width: 100%; height: 100%; object-fit: cover;" />
                                    }
                                </div>
                            </td>
                            <td class="roster-cell data-mono">@member.Name</td>
                            <td class="roster-cell text-muted">@member.Email</td>
                            <td class="roster-cell text-muted">@member.Gender</td>
                            <td class="roster-cell text-muted">@member.PhoneNumber</td>
                            <td class="roster-cell">
                                <div class="d-flex gap-2">
                                    <a asp-controller="Members" asp-action="Details" asp-route-id="@member.Id" class="btn-secondary px-2 py-1" title="View Details">
                                        👁️
                                    </a>
                                    <a asp-controller="Members" asp-action="HealthRecord" asp-route-id="@member.Id" class="btn-secondary px-2 py-1" title="Health Record">
                                        🏥
                                    </a>
                                    <a asp-controller="Members" asp-action="Edit" asp-route-id="@member.Id" class="btn-secondary px-2 py-1" title="Edit">
                                        ✏️
                                    </a>
                                    <a asp-controller="Members" asp-action="Delete" asp-route-id="@member.Id" class="ke-btn ke-btn-primary px-2 py-1" title="Delete" style="background: var(--error);">
                                        🗑️
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card card-elevated text-center py-5">
            <div class="display-lg mb-3">👥</div>
            <h2 class="display-md mb-2">No Members Available</h2>
            <p class="body-md text-muted mb-4">Add your first member to get started</p>
            <a asp-controller="Members" asp-action="Create" class="ke-btn ke-btn-primary">
                <span style="font-size: 1.25rem; font-weight: 700;" class="me-2">+</span>
                Add First Member
            </a>
        </div>
    }
</div>
