@{
    ViewData["Title"] = "Error";
    var requestId = Context.TraceIdentifier;
}

<div class="container" style="text-align: center; padding-top: 100px;">
    <div>
        <div style="font-size: 6rem; margin-bottom: var(--space-xl); animation: shake 0.5s infinite alternate;">
            ⚠️
        </div>

        <h1 class="display-md" style="margin-bottom: var(--space-lg); color: var(--error);">
            OOPS! SOMETHING WENT WRONG
        </h1>

        <p class="body-md text-muted" style="max-width: 600px; margin: 0 auto var(--space-xl);">
            We are experiencing a temporary technical issue with the Gym System. 
            Our technical team has been notified automatically and is working to resolve it.
        </p>

        @if (!string.IsNullOrEmpty(requestId))
        {
            <div class="ke-detail-block" style="display: inline-block; padding: var(--space-lg); margin-bottom: var(--space-xl);">
                <span class="ke-detail-label">Error Tracking ID (Ticket ID)</span>
                <code style="display: block; margin-top: var(--space-sm); color: var(--primary); font-size: 1rem; font-family: var(--font-data);">
                    @requestId
                </code>
            </div>
        }

        <div>
            <a asp-controller="Home" asp-action="Index" class="ke-btn ke-btn-primary">
                ← Back to Home Page
            </a>
        </div>
    </div>
</div>

<style>
    @@keyframes shake {
        from { transform: rotate(-5deg); }
        to { transform: rotate(5deg); }
    }
</style>
