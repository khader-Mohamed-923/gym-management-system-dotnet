@model MemberDashboardResponse
@{
    ViewData["Title"] = "Member Dashboard";
    Layout = "~/Views/Shared/_MemberLayout.cshtml";
}

<div class="container py-5">
    <div class="ke-header-content mb-5">
        <div class="ke-header-text">
            <h1 class="ke-title">WELCOME BACK</h1>
            <p class="ke-subtitle">Track your progress and manage your memberships.</p>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-8">
            <div class="card card-elevated h-100">
                <div class="card-body p-4 p-md-5">
                    <h5 class="ke-section-header mb-4 text-primary">ACTIVE MEMBERSHIP</h5>
                    
                    @if (Model.ActiveMembership != null)
                    {
                        <div class="d-flex align-items-center justify-content-between p-4 border-structural" style="border-color: var(--primary); background: var(--surface-container-low);">
                            <div>
                                <span class="d-inline-block px-3 py-1 label-sm data-mono mb-2" style="border: 2px solid var(--primary); color: var(--primary); background: var(--surface-container-high);">Active</span>
                                <h3 class="headline-md mb-1">@Model.ActiveMembership.PlanName</h3>
                                <p class="body-sm text-muted mb-0">Renews on @Model.ActiveMembership.EndDate</p>
                            </div>
                            <i class="bi bi-check-square-fill display-md text-primary"></i>
                        </div>
                    }
                    else
                    {
                        <div class="p-4 border-structural text-center bg-surface">
                            <p class="body-md text-muted mb-3">You don't have an active membership.</p>
                            <a asp-controller="Member" asp-action="Memberships" class="ke-btn ke-btn-primary">View Plans</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card card-elevated h-100">
                <div class="card-body p-4 text-center d-flex flex-column justify-content-center">
                    <div class="mb-3">
                        <i class="bi bi-fire display-md text-primary"></i>
                    </div>
                    <h2 class="display-md mb-1 text-primary data-mono">@Model.TotalBookings</h2>
                    <p class="label-sm text-muted mb-0">Total Bookings</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card card-elevated">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="ke-section-header mb-0 text-primary">MY BOOKINGS</h5>
                <a asp-controller="Member" asp-action="Bookings" class="btn-secondary px-3 py-1 text-decoration-none">View All</a>
            </div>
            
            @if (Model.UpcomingBookings.Any())
            {
                <div class="row g-3">
                    @foreach (var booking in Model.UpcomingBookings)
                    {
                        <div class="col-md-6">
                            <div class="d-flex align-items-center border-structural bg-surface p-3">
                                <div class="d-flex align-items-center justify-content-center border-structural me-3" style="width: 60px; height: 60px; background: var(--surface-container-high);">
                                    <i class="bi bi-calendar-check fs-4 text-primary"></i>
                                </div>
                                <div>
                                    <h6 class="body-md fw-bold mb-1">@booking.SessionName</h6>
                                    <p class="body-sm text-muted mb-0 data-mono"><i class="bi bi-clock me-1"></i> @booking.Date @booking.Time &bull; Trainer: @booking.TrainerName</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="body-md text-muted text-center py-4">No upcoming bookings found.</p>
            }
        </div>
    </div>
</div>
