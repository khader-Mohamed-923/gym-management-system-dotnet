@model MemberProfileResponse
@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_MemberLayout.cshtml";
}

<div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-5 border-bottom border-structural pb-4">
            <div class="ke-header-text">
                <h1 class="ke-title">MY PROFILE</h1>
                <p class="ke-subtitle">Manage your personal information and health records.</p>
            </div>
            
            @{
                int progress = 50; // Basic info is always there
                if (Model.Address != "Not provided") progress += 25;
                if (Model.HealthRecord.Height > 0 || Model.HealthRecord.Weight > 0) progress += 25;
            }

            <div class="text-end border-structural p-3 bg-surface" style="min-width: 250px;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="label-sm">Profile Completion</span>
                    <span class="body-md data-mono" style="color: @(progress == 100 ? "var(--primary)" : "var(--warning, var(--gold))");">@progress%</span>
                </div>
                <div class="progress border-structural mb-3" style="height: 8px; background: var(--surface-container-highest); border-radius: 0;">
                    <div class="progress-bar" role="progressbar" style="width: @progress%; background: @(progress == 100 ? "var(--primary)" : "var(--warning, var(--gold))"); border-radius: 0;" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                @if (progress < 100)
                {
                    <a asp-action="CompleteProfile" class="ke-btn ke-btn-primary w-100 px-3 py-2 text-decoration-none">
                        <i class="bi bi-pencil-square me-2"></i> Complete Profile
                    </a>
                }
                else
                {
                    <a asp-action="CompleteProfile" class="btn-secondary w-100 px-3 py-2 text-decoration-none">
                        <i class="bi bi-pencil-square me-2"></i> Edit Profile
                    </a>
                }
            </div>
        </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card card-elevated h-100">
                <div class="card-body p-4 p-md-5 text-center d-flex flex-column justify-content-center">
                    <div class="mb-4">
                        @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                        {
                            <img src="@Model.PhotoUrl" alt="Profile Photo" class="border-structural bg-surface" style="width: 150px; height: 150px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-surface d-inline-flex align-items-center justify-content-center border-structural" style="width: 150px; height: 150px;">
                                <i class="bi bi-person text-muted" style="font-size: 5rem;"></i>
                            </div>
                        }
                    </div>
                    <h3 class="display-md mb-2 text-primary">@Model.Name</h3>
                    <p class="body-md text-muted mb-0 data-mono">Member since @Model.JoinDate</p>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card card-elevated mb-4">
                <div class="card-body p-4 p-md-5">
                    <h5 class="ke-section-header mb-4 text-primary pb-2 border-bottom border-structural">PERSONAL INFORMATION</h5>
                    
                    <div class="row g-4">
                        <div class="col-sm-6">
                            <div class="label-sm mb-1 text-muted">Email</div>
                            <p class="body-md data-mono mb-0">@Model.Email</p>
                        </div>
                        <div class="col-sm-6">
                            <div class="label-sm mb-1 text-muted">Phone</div>
                            <p class="body-md data-mono mb-0">@(string.IsNullOrEmpty(Model.Phone) ? "N/A" : Model.Phone)</p>
                        </div>
                        <div class="col-sm-6">
                            <div class="label-sm mb-1 text-muted">Gender</div>
                            <p class="body-md mb-0">@Model.Gender</p>
                        </div>
                        <div class="col-sm-6">
                            <div class="label-sm mb-1 text-muted">Date of Birth</div>
                            <p class="body-md data-mono mb-0">@Model.DateOfBirth</p>
                        </div>
                        <div class="col-12">
                            <div class="label-sm mb-1 text-muted">Address</div>
                            <p class="body-md mb-0">@Model.Address</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card card-elevated">
                <div class="card-body p-4 p-md-5">
                    <h5 class="ke-section-header mb-4 text-primary pb-2 border-bottom border-structural">HEALTH RECORD</h5>
                    
                    <div class="row g-4">
                        <div class="col-sm-4">
                            <div class="label-sm mb-1 text-muted">Height (cm)</div>
                            <p class="headline-md data-mono mb-0 text-primary">@(Model.HealthRecord.Height > 0 ? Model.HealthRecord.Height.ToString() : "--")</p>
                        </div>
                        <div class="col-sm-4">
                            <div class="label-sm mb-1 text-muted">Weight (kg)</div>
                            <p class="headline-md data-mono mb-0 text-primary">@(Model.HealthRecord.Weight > 0 ? Model.HealthRecord.Weight.ToString() : "--")</p>
                        </div>
                        <div class="col-sm-4">
                            <div class="label-sm mb-1 text-muted">Blood Type</div>
                            <p class="headline-md data-mono mb-0" style="color: var(--error);">@(Model.HealthRecord.BloodType == "Unknown" ? "--" : Model.HealthRecord.BloodType)</p>
                        </div>
                        <div class="col-12 pt-3 border-top border-structural mt-4">
                            <div class="label-sm mb-2 text-muted">Medical Notes</div>
                            <p class="body-md text-muted mb-0">@(string.IsNullOrEmpty(Model.HealthRecord.Note) ? "No medical conditions reported." : Model.HealthRecord.Note)</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
