@model TrainerEditViewModel

@{
    ViewData["Title"] = "Edit Trainer";
}

<div class="container py-5">
    
    <div class="ke-header-content mb-5">
        <div class="ke-header-text">
            <h1 class="ke-title">EDIT TRAINER</h1>
            <p class="ke-subtitle">Update professional trainer information</p>
        </div>
    </div>

    @if (TempData[TempDataKeys.SuccessMessage] != null)
    {
        <div class="mb-4 p-3 border-structural bg-surface d-flex align-items-center" style="border-left-color: var(--primary);">
            <i class="bi bi-check-circle-fill text-primary fs-4 me-3"></i>
            <span class="body-md">@TempData[TempDataKeys.SuccessMessage]</span>
        </div>
    }
    else if (TempData[TempDataKeys.ErrorMessage] != null)
    {
        <div class="mb-4 p-3 border-structural bg-surface d-flex align-items-center" style="border-left-color: var(--error);">
            <i class="bi bi-exclamation-triangle-fill text-error fs-4 me-3"></i>
            <span class="body-md text-error">@TempData[TempDataKeys.ErrorMessage]</span>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card card-elevated">
                <div class="card-body p-4 p-md-5">
                    <form asp-controller="Trainers" asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Name" />
                        <input type="hidden" asp-for="DateOfBirth" />
                        <input type="hidden" asp-for="Gender" />

                        <div class="text-center mb-5 pb-4 border-bottom border-structural">
                            <p class="label-sm text-muted mb-2">Editing Profile For</p>
                            <h2 class="display-lg text-primary mb-3">@Model.Name</h2>
                            
                            <div class="d-flex justify-content-center gap-4 text-muted body-sm data-mono">
                                <span><i class="bi bi-calendar3 me-1"></i> @Model.DateOfBirth</span>
                                <span><i class="bi bi-person me-1"></i> @Model.Gender</span>
                            </div>
                        </div>

                        <h3 class="ke-section-header text-primary pb-2 border-bottom border-structural mb-4">
                            CONTACT INFORMATION
                        </h3>

                        <div class="row g-4 mb-5">
                            <div class="col-md-6">
                                <label asp-for="Email" class="label-sm mb-1">Email Address <span class="text-error">*</span></label>
                                <input asp-for="Email" class="input-field" placeholder="Enter email address" />
                                <span asp-validation-for="Email" class="text-error small mt-1"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Phone" class="label-sm mb-1">Phone Number <span class="text-error">*</span></label>
                                <input asp-for="Phone" class="input-field" placeholder="Enter phone number" />
                                <span asp-validation-for="Phone" class="text-error small mt-1"></span>
                            </div>
                        </div>

                        <h3 class="ke-section-header text-primary pb-2 border-bottom border-structural mb-4">
                            ADDRESS INFORMATION
                        </h3>

                        <div class="row g-4 mb-5">
                            <div class="col-md-4">
                                <label asp-for="BuildingNumber" class="label-sm mb-1">Building Number <span class="text-error">*</span></label>
                                <input asp-for="BuildingNumber" class="input-field" placeholder="Enter building number" />
                                <span asp-validation-for="BuildingNumber" class="text-error small mt-1"></span>
                            </div>
                            <div class="col-md-8">
                                <label asp-for="Street" class="label-sm mb-1">Street <span class="text-error">*</span></label>
                                <input asp-for="Street" class="input-field" placeholder="Enter street name" />
                                <span asp-validation-for="Street" class="text-error small mt-1"></span>
                            </div>
                            <div class="col-md-12">
                                <label asp-for="City" class="label-sm mb-1">City <span class="text-error">*</span></label>
                                <input asp-for="City" class="input-field" placeholder="Enter city" />
                                <span asp-validation-for="City" class="text-error small mt-1"></span>
                            </div>
                        </div>

                        <h3 class="ke-section-header text-primary pb-2 border-bottom border-structural mb-4">
                            PROFESSIONAL INFORMATION
                        </h3>

                        <div class="row g-4 mb-5">
                            <div class="col-md-6">
                                <label asp-for="Specialty" class="label-sm mb-1">Specialty <span class="text-error">*</span></label>
                                <select asp-for="Specialty" class="input-field">
                                    <option value="" style="background: var(--surface); color: var(--on-surface);">Select Specialty</option>
                                    <option value="Cardio" style="background: var(--surface); color: var(--on-surface);">Cardio</option>
                                    <option value="Balance" style="background: var(--surface); color: var(--on-surface);">Balance</option>
                                    <option value="Boxing" style="background: var(--surface); color: var(--on-surface);">Boxing</option>
                                    <option value="Yoga" style="background: var(--surface); color: var(--on-surface);">Yoga</option>
                                    <option value="CrossFit" style="background: var(--surface); color: var(--on-surface);">CrossFit</option>
                                    <option value="Fitness" style="background: var(--surface); color: var(--on-surface);">Fitness</option>
                                </select>
                                <span asp-validation-for="Specialty" class="text-error small mt-1"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-3 pt-4 border-top border-structural">
                            <a asp-controller="Trainers" asp-action="Index" class="btn-secondary px-4 py-2">
                                Cancel
                            </a>
                            <button type="submit" class="ke-btn ke-btn-primary px-4 py-2">
                                Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_AlertDismissScript" />
}
