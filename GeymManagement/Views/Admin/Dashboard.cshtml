@model AdminDashboardResponse
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-5">
    <div class="ke-header-content mb-5">
        <div class="ke-header-text">
            <h1 class="ke-title">ADMIN DASHBOARD</h1>
            <p class="ke-subtitle">System overview and management statistics.</p>
        </div>
        <a asp-controller="Admin" asp-action="DownloadReport" class="ke-btn ke-btn-primary">
            <i class="bi bi-file-earmark-bar-graph"></i> Generate Report
        </a>
    </div>

    
    <div class="ke-grid mb-5">
        <div class="card card-elevated text-center">
            <div class="mb-3"><i class="bi bi-people fs-1 text-primary"></i></div>
            <h3 class="stat-value">@Model.TotalActiveMembers</h3>
            <p class="stat-label">Active Members</p>
        </div>

        <div class="card card-elevated text-center">
            <div class="mb-3"><i class="bi bi-person-badge fs-1 text-primary"></i></div>
            <h3 class="stat-value">@Model.TotalTrainers</h3>
            <p class="stat-label">Trainers</p>
        </div>

        <div class="card card-elevated text-center">
            <div class="mb-3"><i class="bi bi-calendar-event fs-1 text-primary"></i></div>
            <h3 class="stat-value">@Model.WeeklySessions</h3>
            <p class="stat-label">Weekly Sessions</p>
        </div>

        <div class="card card-elevated text-center">
            <div class="mb-3"><i class="bi bi-currency-dollar fs-1 text-primary"></i></div>
            <h3 class="stat-value">$@Model.MonthlyRevenue.ToString("N0")</h3>
            <p class="stat-label">Monthly Revenue</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-8">
            <div class="card card-elevated h-100">
                <h5 class="ke-section-header">RECENT REGISTRATIONS</h5>
                <div class="roster-container">
                    <table class="roster-list">
                        <thead>
                            <tr>
                                <th class="roster-header">Name</th>
                                <th class="roster-header">Plan</th>
                                <th class="roster-header">Date</th>
                                <th class="roster-header">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentRegistrations.Any())
                            {
                                @foreach (var reg in Model.RecentRegistrations)
                                {
                                    <tr class="roster-row">
                                        <td class="roster-cell">
                                            <div class="d-flex align-items-center">
                                                <div class="d-flex align-items-center justify-content-center me-3 border-structural bg-surface" style="width: 40px; height: 40px;">
                                                    <i class="bi bi-person text-on-surface"></i>
                                                </div>
                                                <div>
                                                    <div class="data-mono">@reg.Name</div>
                                                    <div class="label-sm text-muted">@reg.Email</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="roster-cell data-mono">@reg.PlanName</td>
                                        <td class="roster-cell text-muted">@reg.Date</td>
                                        <td class="roster-cell">
                                            @if (reg.Status == MembershipStatus.Active)
                                            {
                                                <span class="status-chip status-chip--active">Active</span>
                                            }
                                            else
                                            {
                                                <span class="status-chip status-chip--inactive">Inactive</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr class="roster-row">
                                    <td colspan="4" class="roster-cell text-center py-4 text-muted">No members registered yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card card-elevated h-100">
                <h5 class="ke-section-header">QUICK ACTIONS</h5>
                <div class="d-grid gap-3">
                    <a asp-controller="Members" asp-action="Create" class="btn-secondary d-flex align-items-center justify-content-start p-3 w-100">
                        <div class="me-3 text-primary"><i class="bi bi-person-plus fs-4"></i></div>
                        <div class="text-start">
                            <div class="data-mono">Add New Member</div>
                            <div class="label-sm text-muted">Manually register a user</div>
                        </div>
                    </a>
                    <a asp-controller="Sessions" asp-action="Create" class="btn-secondary d-flex align-items-center justify-content-start p-3 w-100">
                        <div class="me-3 text-primary"><i class="bi bi-calendar-plus fs-4"></i></div>
                        <div class="text-start">
                            <div class="data-mono">Create Session</div>
                            <div class="label-sm text-muted">Schedule a new class</div>
                        </div>
                    </a>
                    <a asp-controller="Plans" asp-action="Index" class="btn-secondary d-flex align-items-center justify-content-start p-3 w-100">
                        <div class="me-3 text-primary"><i class="bi bi-credit-card fs-4"></i></div>
                        <div class="text-start">
                            <div class="data-mono">Manage Plans</div>
                            <div class="label-sm text-muted">Update pricing &amp; features</div>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

