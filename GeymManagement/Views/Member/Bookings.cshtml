@model IEnumerable<MemberBookingResponse>
@{
    ViewData["Title"] = "My Bookings";
    Layout = "~/Views/Shared/_MemberLayout.cshtml";
}

<div class="container py-5">
    <div class="ke-header-content mb-5">
        <div class="ke-header-text">
            <h1 class="ke-title">MY BOOKINGS</h1>
            <p class="ke-subtitle">View your class and session history</p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card card-elevated p-5 text-center">
            <div class="display-lg mb-3">📅</div>
            <h3 class="display-md mb-2">No Bookings Yet</h3>
            <p class="body-md text-muted mb-4">You haven't booked any sessions yet. Check the schedule to get started!</p>
            <a asp-controller="Booking" asp-action="Schedule" class="ke-btn ke-btn-primary px-4 py-2 d-inline-flex align-items-center justify-content-center mx-auto" style="width: fit-content;">
                <i class="bi bi-calendar-event me-2"></i> View Schedule
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var booking in Model)
            {
                var isUpcoming = booking.Status == SessionStatus.Upcoming;
                var borderColor = isUpcoming ? "var(--primary)" : "var(--border-color)";
                var bgClass = isUpcoming ? "bg-surface" : "bg-dark";
                var opacityStyle = isUpcoming ? "" : "opacity: 0.7;";

                <div class="col-md-6 col-lg-4">
                    <div class="card card-elevated h-100" style="border-top-color: @borderColor; @opacityStyle">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex align-items-start gap-3 mb-4 pb-3 border-bottom border-structural">
                                <div class="d-flex align-items-center justify-content-center border-structural" style="width: 48px; height: 48px; flex-shrink: 0; background: var(--surface-container-low); color: var(--primary);">
                                    <i class="bi bi-activity fs-4"></i>
                                </div>
                                <div style="min-width: 0;">
                                    <h3 class="body-md fw-bold text-primary mb-2 text-truncate" title="@booking.SessionName">@booking.SessionName</h3>
                                    <span class="d-inline-block px-2 py-1 label-sm data-mono" style="border: 2px solid @borderColor; color: @(isUpcoming ? "var(--primary)" : "var(--text-muted)"); background: var(--surface-container-high);">
                                        @booking.Status
                                    </span>
                                </div>
                            </div>

                            <div class="mt-auto">
                                <div class="d-flex align-items-center mb-3">
                                    <i class="bi bi-person-badge text-muted me-3 fs-5" style="width: 24px; text-align: center;"></i>
                                    <div class="flex-grow-1">
                                        <div class="label-sm text-muted">Trainer</div>
                                        <div class="body-md">@booking.TrainerName</div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center mb-3">
                                    <i class="bi bi-calendar3 text-muted me-3 fs-5" style="width: 24px; text-align: center;"></i>
                                    <div class="flex-grow-1">
                                        <div class="label-sm text-muted">Date</div>
                                        <div class="body-md data-mono">@booking.Date</div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-clock text-muted me-3 fs-5" style="width: 24px; text-align: center;"></i>
                                    <div class="flex-grow-1">
                                        <div class="label-sm text-muted">Time</div>
                                        <div class="body-md data-mono">@booking.Time</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

