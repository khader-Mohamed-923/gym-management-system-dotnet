@model IEnumerable<MemberMembershipResponse>
@{
    ViewData["Title"] = "My Memberships";
    Layout = "~/Views/Shared/_MemberLayout.cshtml";
}

<div class="container py-5">
    <div class="mb-5">
        <h1 class="fw-bold mb-0 text-white" style="font-family: 'Oswald', sans-serif; letter-spacing: 1px;">MY MEMBERSHIPS</h1>
        <p class="text-muted mt-1 mb-0">Manage your active plans and view membership history.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-lg border-0" style="background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.05) !important; border-radius: 12px;">
            <div class="card-body p-5 text-center">
                <i class="bi bi-card-heading text-secondary" style="font-size: 4rem;"></i>
                <h4 class="text-white mt-3">No memberships found</h4>
                <p class="text-muted">You do not have any active or past memberships.</p>
                <a href="#" class="btn btn-warning mt-3 px-4 py-2 fw-bold" style="background-color: var(--text-accent); border-color: var(--text-accent); color: white;">Explore Plans</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var membership in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-lg border-0 h-100 position-relative overflow-hidden" style="background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.05) !important; border-radius: 12px;">
                        
                        @if (membership.IsActive)
                        {
                            <div class="position-absolute top-0 end-0 p-3">
                                <span class="badge bg-success bg-opacity-25 text-success border border-success px-3 py-2 rounded-pill">
                                    <i class="bi bi-check-circle-fill me-1"></i> Active
                                </span>
                            </div>
                        }
                        else
                        {
                            <div class="position-absolute top-0 end-0 p-3">
                                <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary px-3 py-2 rounded-pill">
                                    Expired
                                </span>
                            </div>
                        }

                        <div class="card-body p-4 p-md-5 d-flex flex-column">
                            <div class="mb-4">
                                <h3 class="fw-bold text-white mb-1" style="font-family: 'Oswald', sans-serif;">@membership.PlanName</h3>
                                <div class="d-flex align-items-baseline">
                                    <h2 class="fw-bold mb-0 me-2" style="color: var(--text-accent);">$@membership.Price</h2>
                                </div>
                            </div>

                            <div class="mt-auto">
                                <hr class="border-secondary mb-4" />
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted small text-uppercase fw-bold letter-spacing-1">Start Date</span>
                                    <span class="text-white fw-bold">@membership.StartDate</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted small text-uppercase fw-bold letter-spacing-1">End Date</span>
                                    <span class="text-white fw-bold">@membership.EndDate</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
