@model GymManagement.Presentation.ViewModels.Trainer.TrainerDashboardViewModel
@{
    ViewData["Title"] = "Trainer Dashboard";
    Layout = "~/Views/Shared/_TrainerLayout.cshtml";
}

<div class="container py-5">
    <div class="mb-5">
        <h1 class="fw-bold mb-0 text-white" style="font-family: 'Oswald', sans-serif; letter-spacing: 1px;">TRAINER DASHBOARD</h1>
        <p class="text-muted mt-1 mb-0">Manage your schedule and assigned sessions.</p>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card shadow-lg border-0 h-100" style="background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.05) !important; border-radius: 12px;">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="rounded-circle d-flex align-items-center justify-content-center me-4" style="width: 60px; height: 60px; background: rgba(249, 115, 22, 0.1); border: 1px solid rgba(249, 115, 22, 0.2);">
                        <i class="bi bi-calendar-event fs-3" style="color: var(--text-accent);"></i>
                    </div>
                    <div>
                        <p class="mb-0 small text-uppercase fw-bold letter-spacing-1" style="color: var(--text-body);">Today's Sessions</p>
                        <h3 class="fw-bold mb-0" style="font-family: 'JetBrains Mono', monospace; color: var(--text-primary);">@Model.TodaysSessionsCount</h3>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card shadow-lg border-0 h-100" style="background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.05) !important; border-radius: 12px;">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="rounded-circle d-flex align-items-center justify-content-center me-4" style="width: 60px; height: 60px; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2);">
                        <i class="bi bi-people fs-3" style="color: var(--text-error);"></i>
                    </div>
                    <div>
                        <p class="mb-0 small text-uppercase fw-bold letter-spacing-1" style="color: var(--text-body);">Total Trainees</p>
                        <h3 class="fw-bold mb-0" style="font-family: 'JetBrains Mono', monospace; color: var(--text-primary);">@Model.TotalTraineesCount</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-lg border-0 h-100" style="background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.05) !important; border-radius: 12px;">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="rounded-circle d-flex align-items-center justify-content-center me-4" style="width: 60px; height: 60px; background: rgba(249, 115, 22, 0.1); border: 1px solid rgba(249, 115, 22, 0.2);">
                        <i class="bi bi-star fs-3" style="color: var(--text-accent);"></i>
                    </div>
                    <div>
                        <p class="mb-0 small text-uppercase fw-bold letter-spacing-1" style="color: var(--text-body);">Avg Rating</p>
                        <h3 class="fw-bold mb-0" style="font-family: 'JetBrains Mono', monospace; color: var(--text-primary);">@Model.AverageRating.ToString("0.0")</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-lg border-0" style="background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.05) !important; border-radius: 12px;">
        <div class="card-body p-5">
            <h5 class="fw-bold mb-4" style="font-family: 'Oswald', sans-serif; color: var(--text-primary);">UPCOMING SESSIONS</h5>
            
            <div class="d-flex flex-column gap-3">
                @if(!Model.UpcomingSessions.Any())
                {
                    <p class="text-muted">No upcoming sessions scheduled.</p>
                }
                else
                {
                    foreach(var session in Model.UpcomingSessions)
                    {
                        var borderClass = session.RegisteredTrainees >= session.MaxCapacity ? "border-left: 4px solid #ef4444;" : "border-left: 4px solid #f97316;";
                        <div class="p-4 rounded" style="background: rgba(0,0,0,0.4); @borderClass">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h5 class="fw-bold mb-1" style="color: var(--text-primary);">@session.Name</h5>
                                    <p class="mb-0" style="color: var(--text-body);"><i class="bi bi-clock me-2"></i> @session.TimeRange &bull; @session.Location</p>
                                </div>
                                <div class="text-end">
                                    @if(session.RegisteredTrainees >= session.MaxCapacity)
                                    {
                                        <span class="badge bg-danger bg-opacity-25 text-danger px-3 py-2 rounded-pill mb-2">Full</span>
                                    }
                                    <div class="small" style="color: var(--text-primary);">@session.RegisteredTrainees/@session.MaxCapacity Registered</div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>
