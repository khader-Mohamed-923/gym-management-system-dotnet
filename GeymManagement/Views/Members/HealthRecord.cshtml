@model HealthRecordDetailsViewModel

@{
    ViewData["Title"] = "Health Record";
}

<div class="container py-5">
    
    <div class="ke-header-content mb-5">
        <div class="ke-header-text">
            <h1 class="ke-title">HEALTH RECORD</h1>
            <p class="ke-subtitle">Member health metrics and information</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card card-elevated">
                <div class="card-body p-4 p-md-5">
                    
                    <div class="text-center mb-5 border-bottom border-structural pb-4">
                        <div class="display-lg mb-3 text-primary">🏥</div>
                        <h2 class="display-md">Health Metrics</h2>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="ke-detail-block" style="border-left-color: var(--primary);">
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <div class="d-flex align-items-center justify-content-center bg-surface border-structural" style="width: 48px; height: 48px; font-size: 1.5rem;">
                                        <span>📏</span>
                                    </div>
                                    <div class="ke-detail-label mb-0">Height</div>
                                </div>
                                <div class="ke-detail-value data-mono text-primary" style="font-size: 2rem;">
                                    @Model.Hight <span class="body-sm text-muted">cm</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="ke-detail-block" style="border-left-color: var(--primary);">
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <div class="d-flex align-items-center justify-content-center bg-surface border-structural" style="width: 48px; height: 48px; font-size: 1.5rem;">
                                        <span>⚖️</span>
                                    </div>
                                    <div class="ke-detail-label mb-0">Weight</div>
                                </div>
                                <div class="ke-detail-value data-mono text-primary" style="font-size: 2rem;">
                                    @Model.Weight <span class="body-sm text-muted">kg</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="ke-detail-block" style="border-left-color: var(--error);">
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <div class="d-flex align-items-center justify-content-center bg-surface border-structural" style="width: 48px; height: 48px; font-size: 1.5rem;">
                                        <span>🩸</span>
                                    </div>
                                    <div class="ke-detail-label mb-0">Blood Type</div>
                                </div>
                                <div class="ke-detail-value data-mono text-error" style="font-size: 2rem;">
                                    @Model.BloodType
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="ke-detail-block">
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <div class="d-flex align-items-center justify-content-center bg-surface border-structural" style="width: 48px; height: 48px; font-size: 1.5rem;">
                                        <span>📝</span>
                                    </div>
                                    <div class="ke-detail-label mb-0">Notes</div>
                                </div>
                                <div class="ke-detail-value text-muted">
                                    @(string.IsNullOrEmpty(Model.Note?.ToString()) ? "No notes" : Model.Note)
                                </div>
                            </div>
                        </div>
                    </div>

                    @{
                        var heightValue = Model.Hight;
                        var weightValue = Model.Weight;
                        
                        if (heightValue.HasValue && weightValue.HasValue && heightValue > 0 && weightValue > 0)
                        {
                            var heightInMeters = (double)heightValue.Value / 100.0;
                            var bmi = (double)weightValue.Value / (heightInMeters * heightInMeters);
                            var bmiCategory = bmi < 18.5 ? "Underweight" : bmi < 25 ? "Normal" : bmi < 30 ? "Overweight" : "Obese";
                            var bmiColor = bmi < 18.5 ? "var(--primary)" : bmi < 25 ? "var(--primary)" : bmi < 30 ? "var(--warning, var(--gold))" : "var(--error)";
                            var borderColor = bmi < 18.5 ? "var(--primary)" : bmi < 25 ? "var(--primary)" : bmi < 30 ? "var(--warning, var(--gold))" : "var(--error)";
                            
                            <div class="mt-5 p-4 text-center border-structural bg-surface">
                                <div class="ke-detail-label mb-2">Calculated BMI</div>
                                <div class="data-mono mb-3" style="font-size: 2.5rem; color: @bmiColor;">@bmi.ToString("F1")</div>
                                <span class="d-inline-block px-3 py-1 label-sm data-mono" style="border: 2px solid @borderColor; color: @bmiColor; background: var(--surface-container-high);">
                                    @bmiCategory
                                </span>
                            </div>
                        }
                    }

                    <div class="mt-5 pt-4 border-top border-structural text-center">
                        <a asp-controller="Members" asp-action="Index" class="btn-secondary w-100">
                            ← Back to Members
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
